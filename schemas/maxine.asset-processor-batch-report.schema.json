{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine.asset-processor-batch-report.schema.json",
  "title": "MAXINE Asset Processor Batch Proof Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "report_id",
    "generated_at",
    "mode",
    "status",
    "integration_enabled",
    "strict_integration",
    "live_asset_processor_batch_execution",
    "platform",
    "lane",
    "source_assets",
    "expected_products",
    "produced_products",
    "pending_assets",
    "missing_products",
    "cache_heuristic_used",
    "errors",
    "warnings",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "asset_processor_batch_golden_corpus_v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "local_asset_processor_batch",
        "unavailable",
        "invalid"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "stalled",
        "skipped"
      ]
    },
    "integration_enabled": {
      "type": "boolean"
    },
    "integration_executed": {
      "type": "boolean"
    },
    "strict_integration": {
      "type": "boolean"
    },
    "live_asset_processor_batch_execution": {
      "type": "boolean"
    },
    "o3de_engine_root_present": {
      "type": "boolean"
    },
    "o3de_project_path_present": {
      "type": "boolean"
    },
    "asset_processor_batch_executable": {
      "type": "string"
    },
    "command_preview": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runner_context": {
      "type": "object",
      "additionalProperties": true
    },
    "golden_project_fixture_ref": {
      "type": "string"
    },
    "command": {
      "type": "object",
      "additionalProperties": true
    },
    "logs": {
      "type": "object",
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "additionalProperties": true
    },
    "approved_runtime_character_prefab_source_staging": {
      "type": "object",
      "additionalProperties": true
    },
    "apb_report_ref": {
      "type": "string"
    },
    "live_editor_execution": {
      "type": "boolean"
    },
    "live_publication": {
      "type": "boolean"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_log_ref": {
      "type": "string"
    },
    "stderr_log_ref": {
      "type": "string"
    },
    "asset_processor_log_ref": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": [
        "draft_mesh",
        "release_rigged",
        "external_rig_import"
      ]
    },
    "source_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path"
        ]
      }
    },
    "expected_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "produced_products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "product_type",
          "product_path",
          "platform",
          "status"
        ]
      }
    },
    "pending_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "missing_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cache_heuristic_used": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "kind"
        ]
      }
    }
  }
}
