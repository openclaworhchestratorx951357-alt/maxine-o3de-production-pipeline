{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_ap_evidence_import.schema.json",
  "title": "Maxine AP Evidence Import",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "ap_evidence_import_id",
    "source_proposal_id",
    "source_project_inventory_id",
    "source_asset_candidate_inventory_id",
    "sandbox_root",
    "input_evidence_paths",
    "imported_log_paths",
    "imported_snapshot_metadata_paths",
    "observed_source_paths",
    "observed_product_like_mentions",
    "observed_warning_mentions",
    "observed_error_mentions",
    "observed_asset_processor_state",
    "evidence_quality",
    "required_next_evidence",
    "blocking_reasons",
    "warnings",
    "read_only",
    "asset_processor_execution_admitted",
    "o3de_execution_admitted",
    "cache_access_admitted",
    "live_database_access_admitted",
    "product_ids_claimed",
    "asset_ids_claimed",
    "source_uuids_claimed",
    "product_resolution_claimed",
    "spawn_admitted",
    "publish_admitted",
    "explicit_non_admissions",
    "output_path",
    "created_utc"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "ap_evidence_import_id": { "type": "string", "minLength": 1 },
    "source_proposal_id": { "type": "string", "minLength": 1 },
    "source_project_inventory_id": { "type": "string", "minLength": 1 },
    "source_asset_candidate_inventory_id": { "type": "string", "minLength": 1 },
    "sandbox_root": { "type": "string", "const": "examples/sandbox" },
    "input_evidence_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "imported_log_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "imported_snapshot_metadata_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_source_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_product_like_mentions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_warning_mentions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_error_mentions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_asset_processor_state": { "type": "string", "minLength": 1 },
    "evidence_quality": {
      "type": "string",
      "enum": [
        "none",
        "weak",
        "partial",
        "strong_snapshot_only"
      ]
    },
    "required_next_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocking_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "read_only": { "type": "boolean", "const": true },
    "asset_processor_execution_admitted": { "type": "boolean", "const": false },
    "o3de_execution_admitted": { "type": "boolean", "const": false },
    "cache_access_admitted": { "type": "boolean", "const": false },
    "live_database_access_admitted": { "type": "boolean", "const": false },
    "product_ids_claimed": { "type": "boolean", "const": false },
    "asset_ids_claimed": { "type": "boolean", "const": false },
    "source_uuids_claimed": { "type": "boolean", "const": false },
    "product_resolution_claimed": { "type": "boolean", "const": false },
    "spawn_admitted": { "type": "boolean", "const": false },
    "publish_admitted": { "type": "boolean", "const": false },
    "explicit_non_admissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "output_path": { "type": "string", "minLength": 1 },
    "created_utc": { "type": "string", "minLength": 1 }
  }
}
