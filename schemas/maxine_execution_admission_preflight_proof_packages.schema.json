{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_execution_admission_preflight_proof_packages.schema.json",
  "title": "MAXINE Execution Admission Preflight Proof Packages v1",
  "description": "Static candidate-specific preflight proof packages. This contract is evidence-only planning/reporting and must not imply real execution or publication admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "proof_packages_id",
    "proof_packages_version",
    "generated_for_branch_or_commit",
    "candidate_matrix_ref",
    "preflight_contracts_ref",
    "approval_phrase_format",
    "production_ready_claimed",
    "publication_admitted_claimed",
    "real_execution_admission_status",
    "publication_admission_status",
    "admitted_noop_receipt_candidate_ids",
    "admitted_real_execution_candidate_ids",
    "admitted_publication_candidate_ids",
    "real_execution_preflight_passed_candidate_ids",
    "publication_preflight_passed_candidate_ids",
    "blocked_real_execution_preflight_candidate_ids",
    "blocked_publication_preflight_candidate_ids",
    "blocked_dry_run_preflight_candidate_ids",
    "proof_packages",
    "claim_status",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "EXECUTION_ADMISSION_PREFLIGHT_PROOF_PACKAGES_v1"
    },
    "proof_packages_id": {
      "type": "string",
      "minLength": 1
    },
    "proof_packages_version": {
      "type": "string",
      "const": "v1"
    },
    "generated_for_branch_or_commit": {
      "type": "string",
      "minLength": 1
    },
    "candidate_matrix_ref": {
      "type": "string",
      "minLength": 1
    },
    "preflight_contracts_ref": {
      "type": "string",
      "minLength": 1
    },
    "approval_phrase_format": {
      "type": "string",
      "const": "APPROVE EXECUTION ADMISSION <candidate_id>"
    },
    "production_ready_claimed": {
      "type": "boolean",
      "const": false
    },
    "publication_admitted_claimed": {
      "type": "boolean",
      "const": false
    },
    "real_execution_admission_status": {
      "type": "string",
      "enum": [
        "blocked",
        "admitted"
      ]
    },
    "publication_admission_status": {
      "type": "string",
      "enum": [
        "blocked",
        "admitted"
      ]
    },
    "admitted_noop_receipt_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "admitted_real_execution_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "admitted_publication_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "real_execution_preflight_passed_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "publication_preflight_passed_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "blocked_real_execution_preflight_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "blocked_publication_preflight_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "blocked_dry_run_preflight_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "proof_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proofPackage"
      }
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "evidence_only",
        "not_authoritative"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "o3de_execution_status",
        "editor_runtime_execution_status",
        "asset_processor_execution_status",
        "blender_dcc_execution_status",
        "profiler_benchmark_execution_status",
        "live_screenshot_capture_status",
        "spawn_publish_status",
        "cache_live_db_access_status",
        "production_write_status",
        "engine_write_status"
      ],
      "properties": {
        "o3de_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "editor_runtime_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "asset_processor_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "blender_dcc_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "profiler_benchmark_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "live_screenshot_capture_status": {
          "type": "string",
          "const": "blocked"
        },
        "spawn_publish_status": {
          "type": "string",
          "const": "blocked"
        },
        "cache_live_db_access_status": {
          "type": "string",
          "const": "blocked"
        },
        "production_write_status": {
          "type": "string",
          "const": "blocked"
        },
        "engine_write_status": {
          "type": "string",
          "const": "blocked"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "real_execution_admission_status": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_real_execution_candidate_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "real_execution_admission_status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_real_execution_candidate_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_admission_status": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_publication_candidate_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_admission_status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_publication_candidate_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "properties": {
        "real_execution_preflight_passed_candidate_ids": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "publication_preflight_passed_candidate_ids": {
          "maxItems": 0
        }
      }
    },
    {
      "not": {
        "properties": {
          "admitted_real_execution_candidate_ids": {
            "contains": {
              "const": "release_candidate_package_receipt_noop_v1"
            }
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "admitted_publication_candidate_ids": {
            "contains": {
              "const": "release_candidate_package_receipt_noop_v1"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "proofPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_type",
        "proof_package_version",
        "proof_package_status",
        "admission_status",
        "preflight_contract_status",
        "preflight_passed",
        "matrix_candidate_status",
        "contract_reference",
        "matrix_reference",
        "required_evidence_items",
        "present_evidence_items",
        "missing_evidence_items",
        "blocked_reason_codes",
        "blocked_reason_summary",
        "required_validator",
        "validator_status",
        "required_receipt_schema",
        "receipt_status",
        "rollback_plan_status",
        "approval_status",
        "approval_phrase_required",
        "allowed_sandbox_paths_status",
        "forbidden_paths_status",
        "blocked_surfaces_status",
        "unsafe_claims_detected",
        "production_readiness_effect",
        "publication_effect",
        "next_required_action",
        "safety_notes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_type": {
          "type": "string",
          "enum": [
            "evidence_only",
            "no_op_receipt",
            "dry_run",
            "real_execution",
            "publication"
          ]
        },
        "proof_package_version": {
          "type": "string",
          "const": "v1"
        },
        "proof_package_status": {
          "type": "string",
          "enum": [
            "requirements_only",
            "blocked_missing_evidence",
            "blocked_missing_validator",
            "blocked_missing_receipt_schema",
            "blocked_missing_rollback_plan",
            "blocked_missing_approval",
            "satisfied_no_op_only",
            "satisfied_non_execution_only",
            "superseded",
            "rejected"
          ]
        },
        "admission_status": {
          "type": "string",
          "enum": [
            "unadmitted",
            "admitted_no_op_only",
            "admitted_real_execution",
            "admitted_publication"
          ]
        },
        "preflight_contract_status": {
          "type": "string",
          "enum": [
            "draft",
            "blocked",
            "requirements_defined",
            "review_ready",
            "passed",
            "superseded",
            "rejected"
          ]
        },
        "preflight_passed": {
          "type": "boolean"
        },
        "matrix_candidate_status": {
          "type": "string",
          "enum": [
            "proposed",
            "blocked",
            "review_ready",
            "admitted",
            "superseded",
            "rejected"
          ]
        },
        "contract_reference": {
          "type": "string",
          "minLength": 1
        },
        "matrix_reference": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence_items": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "present_evidence_items": {
          "$ref": "#/$defs/stringArray"
        },
        "missing_evidence_items": {
          "$ref": "#/$defs/stringArray"
        },
        "blocked_reason_codes": {
          "$ref": "#/$defs/stringArray"
        },
        "blocked_reason_summary": {
          "type": "string",
          "minLength": 1
        },
        "required_validator": {
          "type": "string"
        },
        "validator_status": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "not_required"
          ]
        },
        "required_receipt_schema": {
          "type": "string"
        },
        "receipt_status": {
          "type": "string",
          "enum": [
            "receipt_backed_noop",
            "required_not_generated",
            "not_required"
          ]
        },
        "rollback_plan_status": {
          "type": "string",
          "enum": [
            "defined",
            "required_not_proven",
            "not_required"
          ]
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "approved_noop_only",
            "blocked_missing_approval",
            "unadmitted",
            "not_required"
          ]
        },
        "approval_phrase_required": {
          "type": "string",
          "pattern": "^APPROVE EXECUTION ADMISSION .+$"
        },
        "approval_decision_reference": {
          "type": "string"
        },
        "allowed_sandbox_paths_status": {
          "type": "string",
          "enum": [
            "sandbox_only",
            "missing",
            "unsafe"
          ]
        },
        "forbidden_paths_status": {
          "type": "string",
          "enum": [
            "forbidden_paths_present",
            "missing",
            "unsafe"
          ]
        },
        "blocked_surfaces_status": {
          "type": "string",
          "enum": [
            "all_blocked",
            "missing_blocked_surface",
            "unsafe_allowed"
          ]
        },
        "unsafe_claims_detected": {
          "type": "boolean"
        },
        "production_readiness_effect": {
          "type": "string",
          "enum": [
            "noop_receipt_only_review_ready_blocked_for_execution",
            "execution_blocked_missing_preflight_proof",
            "publication_blocked_missing_preflight_proof",
            "review_ready_blocked_for_execution"
          ]
        },
        "publication_effect": {
          "type": "string",
          "enum": [
            "noop_only_not_publication",
            "publication_blocked",
            "dry_run_only_publication_blocked",
            "publication_blocked_missing_preflight_proof"
          ]
        },
        "next_required_action": {
          "type": "string",
          "minLength": 1
        },
        "safety_notes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "candidate_type": {
                "enum": [
                  "real_execution",
                  "publication"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "admission_status": {
                "const": "unadmitted"
              },
              "preflight_passed": {
                "const": false
              },
              "blocked_surfaces_status": {
                "const": "all_blocked"
              },
              "forbidden_paths_status": {
                "const": "forbidden_paths_present"
              },
              "allowed_sandbox_paths_status": {
                "const": "sandbox_only"
              },
              "unsafe_claims_detected": {
                "const": false
              }
            },
            "required": [
              "approval_phrase_required"
            ],
            "allOf": [
              {
                "properties": {
                  "missing_evidence_items": {
                    "minItems": 1
                  },
                  "blocked_reason_codes": {
                    "minItems": 1
                  },
                  "required_validator": {
                    "minLength": 1
                  },
                  "required_receipt_schema": {
                    "minLength": 1
                  }
                }
              },
              {
                "not": {
                  "properties": {
                    "proof_package_status": {
                      "enum": [
                        "satisfied_no_op_only",
                        "satisfied_non_execution_only"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "candidate_type": {
                "const": "dry_run"
              }
            }
          },
          "then": {
            "properties": {
              "admission_status": {
                "const": "unadmitted"
              },
              "preflight_passed": {
                "const": false
              },
              "required_validator": {
                "minLength": 1
              },
              "unsafe_claims_detected": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate_id": {
                "const": "release_candidate_package_receipt_noop_v1"
              }
            },
            "required": [
              "candidate_id"
            ]
          },
          "then": {
            "properties": {
              "candidate_type": {
                "const": "no_op_receipt"
              },
              "admission_status": {
                "const": "admitted_no_op_only"
              },
              "proof_package_status": {
                "enum": [
                  "satisfied_no_op_only",
                  "satisfied_non_execution_only"
                ]
              },
              "publication_effect": {
                "const": "noop_only_not_publication"
              },
              "blocked_surfaces_status": {
                "const": "all_blocked"
              },
              "unsafe_claims_detected": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
