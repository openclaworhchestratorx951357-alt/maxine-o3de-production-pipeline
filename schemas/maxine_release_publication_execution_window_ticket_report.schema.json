{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_release_publication_execution_window_ticket_report.schema.json",
  "title": "MAXINE Release Publication Execution Window Ticket Report",
  "description": "Evidence-only synthesis contract for release publication execution window ticket aggregation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "job_id",
    "package_id",
    "lane",
    "status",
    "source",
    "readiness_contract",
    "execution_window_ticket",
    "approval_state",
    "readiness",
    "findings",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "RELEASE_PUBLICATION_EXECUTION_WINDOW_TICKET_v1_REPORT"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "pending_manual"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_path",
        "source_kind"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "readiness_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "contract_id",
        "required_gate_ids",
        "required_window_ticket_artifact_ids",
        "required_approvals",
        "manual_review_required",
        "immutable_window_ticket_required",
        "hash_verification_required",
        "evidence_only",
        "execution_admitted"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "const": "RELEASE_PUBLICATION_EXECUTION_WINDOW_TICKET_v1"
        },
        "required_gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_window_ticket_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_approvals": {
          "type": "integer",
          "minimum": 1
        },
        "manual_review_required": {
          "type": "boolean"
        },
        "immutable_window_ticket_required": {
          "type": "boolean",
          "const": true
        },
        "hash_verification_required": {
          "type": "boolean",
          "const": true
        },
        "evidence_only": {
          "type": "boolean",
          "const": true
        },
        "execution_admitted": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "execution_window_ticket": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "window_ticket_id",
        "window_ticket_recorded_utc",
        "window_ticket_recorded_by",
        "window_ticket_action",
        "window_ticket_scope",
        "promotion_decision_id",
        "source_execution_authorization_record_id",
        "source_execution_authorization_record_path",
        "source_execution_authorization_record_sha256",
        "execution_receipt_id",
        "rollback_drill_id",
        "evidence_integrity_index_id",
        "hash_algorithm",
        "window_ticket_artifact_hashes",
        "artifact_count",
        "window_ticket_verification_status",
        "missing_window_ticket_artifact_ids",
        "hash_mismatch_window_ticket_artifact_ids",
        "chain_manifest_path",
        "no_command_execution_recorded",
        "window_ticket_path",
        "window_ticket_sha256",
        "window_ticket_artifacts",
        "window_ticket_immutable"
      ],
      "properties": {
        "window_ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "window_ticket_recorded_utc": {
          "type": "string",
          "minLength": 1
        },
        "window_ticket_recorded_by": {
          "type": "string",
          "minLength": 1
        },
        "window_ticket_action": {
          "type": "string",
          "enum": [
            "record_release_publication_execution_window_ticket"
          ]
        },
        "window_ticket_scope": {
          "type": "string",
          "enum": [
            "release_publication_chain"
          ]
        },
        "promotion_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "source_execution_authorization_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_execution_authorization_record_path": {
          "type": "string",
          "minLength": 1
        },
        "source_execution_authorization_record_sha256": {
          "type": "string",
          "minLength": 1
        },
        "execution_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "rollback_drill_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_integrity_index_id": {
          "type": "string",
          "minLength": 1
        },
        "hash_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "window_ticket_artifact_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 1
        },
        "window_ticket_verification_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "pending_manual"
          ]
        },
        "missing_window_ticket_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hash_mismatch_window_ticket_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chain_manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "no_command_execution_recorded": {
          "type": "boolean",
          "const": true
        },
        "window_ticket_path": {
          "type": "string",
          "minLength": 1
        },
        "window_ticket_sha256": {
          "type": "string",
          "minLength": 1
        },
        "window_ticket_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "window_ticket_immutable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "approval_state": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "decision",
        "approver_ids",
        "blocked_reason_codes",
        "rollback_plan_verified",
        "cleanup_plan_verified",
        "publish_execution_admitted",
        "o3de_execution_admitted",
        "asset_processor_execution_admitted",
        "spawn_execution_admitted"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "execution_window_ticket_recorded_for_future_manual_execution_window",
            "pending_manual_review",
            "rejected"
          ]
        },
        "approver_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_plan_verified": {
          "type": "boolean"
        },
        "cleanup_plan_verified": {
          "type": "boolean"
        },
        "publish_execution_admitted": {
          "type": "boolean",
          "const": false
        },
        "o3de_execution_admitted": {
          "type": "boolean",
          "const": false
        },
        "asset_processor_execution_admitted": {
          "type": "boolean",
          "const": false
        },
        "spawn_execution_admitted": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "required_gate_ids",
        "present_gate_ids",
        "missing_gate_ids",
        "execution_window_ticket_readiness_state"
      ],
      "properties": {
        "required_gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "present_gate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_gate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution_window_ticket_readiness_state": {
          "type": "string",
          "enum": [
            "execution_window_ticket_recorded_for_future_manual_execution_window",
            "blocked_missing_evidence",
            "blocked_safety_boundary"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "manual_review"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "const": "qc.gates[]"
        },
        "future_target_path": {
          "type": "string",
          "const": "qc.checks[]"
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "const": "release_publication_execution_window_ticket_v1"
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "warn",
                "fail",
                "pending_manual"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "manual_review"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
