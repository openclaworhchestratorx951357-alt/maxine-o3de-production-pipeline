{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_asset_candidate_evidence_bundle.schema.json",
  "title": "Maxine Asset Candidate Evidence Bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "bundle_id",
    "source_inventory_id",
    "source_review_packet_id",
    "candidate_id",
    "sandbox_root",
    "bundle_path",
    "included_artifacts",
    "copied_artifact_paths",
    "artifact_sha256",
    "safety_summary",
    "explicit_non_admissions",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "source_inventory_id": {
      "type": "string",
      "minLength": 1
    },
    "source_review_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "sandbox_root": {
      "type": "string",
      "const": "examples/sandbox"
    },
    "bundle_path": {
      "type": "string",
      "minLength": 1
    },
    "included_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "copied_artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "artifact_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    },
    "safety_summary": {
      "type": "string",
      "minLength": 1
    },
    "explicit_non_admissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "created_utc": {
      "type": "string",
      "minLength": 1
    }
  }
}
