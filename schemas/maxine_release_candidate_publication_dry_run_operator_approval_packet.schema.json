{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_release_candidate_publication_dry_run_operator_approval_packet.schema.json",
  "title": "MAXINE Release Candidate Publication Dry-Run Operator Approval Packet Template v1",
  "description": "Static operator-review packet template for release_candidate_package_publish_dry_run_v1. This artifact is template-only and must not imply approval, approval-readiness, admission, execution, receipt issuance, publication admission, or production readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "packet_id",
    "packet_version",
    "candidate_id",
    "candidate_type",
    "approval_packet_status",
    "admission_status",
    "approval_request_ready",
    "operator_approval_granted",
    "approval_phrase_present",
    "dry_run_admitted",
    "receipt_issued",
    "publication_admitted",
    "real_execution_admitted",
    "production_ready_claimed",
    "generated_from_static_artifacts_only",
    "source_artifacts",
    "source_artifact_validation_status",
    "operator_review_summary",
    "approval_blocker_summary",
    "required_operator_review_items",
    "required_validation_commands",
    "expected_future_receipt_contract",
    "rollback_or_cleanup_expectations",
    "blocked_surface_attestations",
    "forbidden_actions",
    "forbidden_outputs",
    "forbidden_paths",
    "approval_phrase_required",
    "approval_decision_reference",
    "approval_decision_fields",
    "operator_decision_options",
    "required_post_approval_controls",
    "unsafe_claims_detected",
    "safest_next_action",
    "safety_posture",
    "safety_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "RELEASE_CANDIDATE_PUBLICATION_DRY_RUN_OPERATOR_APPROVAL_PACKET_v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_version": {
      "type": "string",
      "const": "v1"
    },
    "candidate_id": {
      "type": "string",
      "const": "release_candidate_package_publish_dry_run_v1"
    },
    "candidate_type": {
      "type": "string",
      "const": "dry_run"
    },
    "approval_packet_status": {
      "type": "string",
      "enum": [
        "static_template_valid_blocked",
        "static_template_invalid",
        "blocked_missing_source_artifact",
        "blocked_inconsistent_source_artifacts",
        "superseded"
      ]
    },
    "admission_status": {
      "type": "string",
      "const": "unadmitted"
    },
    "approval_request_ready": {
      "type": "boolean",
      "const": false
    },
    "operator_approval_granted": {
      "type": "boolean",
      "const": false
    },
    "approval_phrase_present": {
      "type": "boolean",
      "const": false
    },
    "dry_run_admitted": {
      "type": "boolean",
      "const": false
    },
    "receipt_issued": {
      "type": "boolean",
      "const": false
    },
    "publication_admitted": {
      "type": "boolean",
      "const": false
    },
    "real_execution_admitted": {
      "type": "boolean",
      "const": false
    },
    "production_ready_claimed": {
      "type": "boolean",
      "const": false
    },
    "generated_from_static_artifacts_only": {
      "type": "boolean",
      "const": true
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_ref",
        "preflight_contracts_ref",
        "preflight_proof_packages_ref",
        "readiness_rollup_ref",
        "dry_run_plan_ref",
        "dry_run_receipt_contract_ref",
        "blocked_unissued_receipt_ref",
        "admission_blocker_checklist_ref",
        "production_readiness_report_ref",
        "noop_receipt_status_ref"
      ],
      "properties": {
        "candidate_matrix_ref": {
          "type": "string",
          "minLength": 1
        },
        "preflight_contracts_ref": {
          "type": "string",
          "minLength": 1
        },
        "preflight_proof_packages_ref": {
          "type": "string",
          "minLength": 1
        },
        "readiness_rollup_ref": {
          "type": "string",
          "minLength": 1
        },
        "dry_run_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "dry_run_receipt_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "blocked_unissued_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "admission_blocker_checklist_ref": {
          "type": "string",
          "minLength": 1
        },
        "production_readiness_report_ref": {
          "type": "string",
          "minLength": 1
        },
        "noop_receipt_status_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_artifact_validation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_status",
        "preflight_contracts_status",
        "preflight_proof_packages_status",
        "readiness_rollup_status",
        "dry_run_plan_status",
        "dry_run_receipt_contract_status",
        "blocked_unissued_receipt_status",
        "admission_blocker_checklist_status",
        "production_readiness_status",
        "noop_receipt_status"
      ],
      "properties": {
        "candidate_matrix_status": {
          "$ref": "#/$defs/statusValue"
        },
        "preflight_contracts_status": {
          "$ref": "#/$defs/statusValue"
        },
        "preflight_proof_packages_status": {
          "$ref": "#/$defs/statusValue"
        },
        "readiness_rollup_status": {
          "$ref": "#/$defs/statusValue"
        },
        "dry_run_plan_status": {
          "$ref": "#/$defs/statusValue"
        },
        "dry_run_receipt_contract_status": {
          "$ref": "#/$defs/statusValue"
        },
        "blocked_unissued_receipt_status": {
          "$ref": "#/$defs/statusValue"
        },
        "admission_blocker_checklist_status": {
          "$ref": "#/$defs/statusValue"
        },
        "production_readiness_status": {
          "$ref": "#/$defs/statusValue"
        },
        "noop_receipt_status": {
          "$ref": "#/$defs/statusValue"
        }
      }
    },
    "operator_review_summary": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "approval_blocker_summary": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "required_operator_review_items": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "required_validation_commands": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "expected_future_receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_contract_ref",
        "receipt_type",
        "receipt_contract_status_expected"
