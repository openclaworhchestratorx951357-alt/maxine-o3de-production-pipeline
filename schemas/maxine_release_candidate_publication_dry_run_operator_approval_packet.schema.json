        "receipt_type": {
          "type": "string",
          "const": "release_candidate_package_publish_dry_run_receipt_v1"
        },
        "receipt_contract_status_expected": {
          "type": "string",
          "const": "static_contract_valid_blocked"
        }
      }
    },
    "rollback_or_cleanup_expectations": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "blocked_surface_attestations": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "forbidden_outputs": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "forbidden_paths": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "approval_phrase_required": {
      "type": "string",
      "const": "APPROVE EXECUTION ADMISSION release_candidate_package_publish_dry_run_v1"
    },
    "approval_decision_reference": {
      "type": [
        "null",
        "string"
      ]
    },
    "approval_decision_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver_identity",
        "approval_timestamp_utc",
        "approval_phrase_exact",
        "approved_candidate_id",
        "approval_scope",
        "approval_limitations",
        "source_packet_hash",
        "source_artifact_hashes",
        "validation_summary_at_approval",
        "rollback_acceptance",
        "safety_attestation"
      ],
      "properties": {
        "approver_identity": {
          "type": [
            "null",
            "string"
          ]
        },
        "approval_timestamp_utc": {
          "type": [
            "null",
            "string"
          ]
        },
        "approval_phrase_exact": {
          "type": [
            "null",
            "string"
          ]
        },
        "approved_candidate_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "approval_scope": {
          "type": [
            "null",
            "string"
          ]
        },
        "approval_limitations": {
          "type": [
            "null",
            "string"
          ]
        },
        "source_packet_hash": {
          "type": [
            "null",
            "string"
          ]
        },
        "source_artifact_hashes": {
          "type": [
            "null",
            "string"
          ]
        },
        "validation_summary_at_approval": {
          "type": [
            "null",
            "string"
          ]
        },
        "rollback_acceptance": {
          "type": [
            "null",
            "string"
          ]
        },
        "safety_attestation": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "operator_decision_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_options",
        "default_option"
      ],
      "properties": {
        "allowed_options": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "default_option": {
          "type": "string",
          "const": "do_not_approve"
        }
      }
    },
    "required_post_approval_controls": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "unsafe_claims_detected": {
      "type": "boolean",
      "const": false
    },
    "safest_next_action": {
      "type": "string",
      "minLength": 1
    },
    "safety_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uuid_status",
        "asset_id_status",
        "product_id_status"
      ],
      "properties": {
        "source_uuid_status": {
          "type": "string",
          "const": "not_authoritative"
        },
        "asset_id_status": {
          "type": "string",
          "const": "not_authoritative"
        },
        "product_id_status": {
          "type": "string",
          "const": "not_authoritative"
        }
      }
    },
    "safety_notes": {
      "$ref": "#/$defs/nonEmptyStringArray"
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statusValue": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_decision_reference": {
            "type": "string"
          }
        },
        "required": [
          "approval_decision_reference"
        ]
      },
      "then": {
        "properties": {
          "approval_decision_reference": {
            "maxLength": 0
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "candidate_identity_and_candidate_type"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "current_admission_status"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "source_artifact_validation_summary"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "admission_blocker_checklist_summary"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "dry_run_plan_summary"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "dry_run_receipt_contract_summary"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "blocked_unissued_receipt_summary"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "required_approval_phrase"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "required_future_validation_commands"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "rollback_noop_cleanup_expectations"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "forbidden_surfaces"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "forbidden_outputs"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "forbidden_paths"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
          "contains": {
            "const": "operator_decision_options"
          }
        }
      }
    },
    {
      "properties": {
        "required_operator_review_items": {
