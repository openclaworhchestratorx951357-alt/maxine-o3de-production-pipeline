{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_release_candidate_publication_dry_run_admission_blockers.schema.json",
  "title": "MAXINE Release Candidate Publication Dry-Run Admission Blockers v1",
  "description": "Static admission-blocker checklist for release_candidate_package_publish_dry_run_v1. This artifact is status-only and must not imply approval, admission, execution, receipt issuance, publication admission, or production readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "checklist_id",
    "checklist_version",
    "candidate_id",
    "candidate_type",
    "checklist_status",
    "admission_status",
    "approval_review_ready",
    "dry_run_admitted",
    "receipt_issued",
    "publication_admitted",
    "real_execution_admitted",
    "production_ready_claimed",
    "generated_from_static_artifacts_only",
    "source_artifacts",
    "source_artifact_validation_status",
    "prerequisite_checklist",
    "admission_blockers",
    "approval_blockers",
    "evidence_blockers",
    "receipt_blockers",
    "rollback_or_cleanup_blockers",
    "safety_blockers",
    "publication_blockers",
    "execution_blockers",
    "ready_to_request_approval",
    "approval_phrase_required",
    "approval_decision_reference",
    "safest_next_action",
    "unsafe_claims_detected",
    "claim_status",
    "safety_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "RELEASE_CANDIDATE_PUBLICATION_DRY_RUN_ADMISSION_BLOCKERS_v1"
    },
    "checklist_id": {
      "type": "string",
      "minLength": 1
    },
    "checklist_version": {
      "type": "string",
      "const": "v1"
    },
    "candidate_id": {
      "type": "string",
      "const": "release_candidate_package_publish_dry_run_v1"
    },
    "candidate_type": {
      "type": "string",
      "const": "dry_run"
    },
    "checklist_status": {
      "type": "string",
      "enum": [
        "static_checklist_valid_blocked",
        "static_checklist_invalid",
        "blocked_missing_source_artifact",
        "blocked_inconsistent_source_artifacts",
        "superseded"
      ]
    },
    "admission_status": {
      "type": "string",
      "const": "unadmitted"
    },
    "approval_review_ready": {
      "oneOf": [
        {
          "type": "boolean",
          "const": false
        },
        {
          "type": "string",
          "const": "blocked"
        }
      ]
    },
    "dry_run_admitted": {
      "type": "boolean",
      "const": false
    },
    "receipt_issued": {
      "type": "boolean",
      "const": false
    },
    "publication_admitted": {
      "type": "boolean",
      "const": false
    },
    "real_execution_admitted": {
      "type": "boolean",
      "const": false
    },
    "production_ready_claimed": {
      "type": "boolean",
      "const": false
    },
    "generated_from_static_artifacts_only": {
      "type": "boolean",
      "const": true
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_ref",
        "preflight_contracts_ref",
        "preflight_proof_packages_ref",
        "readiness_rollup_ref",
        "dry_run_plan_ref",
        "dry_run_receipt_contract_ref",
        "blocked_unissued_receipt_ref",
        "production_readiness_report_ref",
        "noop_receipt_status_ref"
      ],
      "properties": {
        "candidate_matrix_ref": {
          "type": "string",
          "minLength": 1
        },
        "preflight_contracts_ref": {
          "type": "string",
          "minLength": 1
        },
        "preflight_proof_packages_ref": {
          "type": "string",
          "minLength": 1
        },
        "readiness_rollup_ref": {
          "type": "string",
          "minLength": 1
        },
        "dry_run_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "dry_run_receipt_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "blocked_unissued_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "production_readiness_report_ref": {
          "type": "string",
          "minLength": 1
        },
        "noop_receipt_status_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_artifact_validation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_status",
        "preflight_contracts_status",
        "preflight_proof_packages_status",
        "readiness_rollup_status",
        "dry_run_plan_status",
        "dry_run_receipt_contract_status",
        "blocked_unissued_receipt_status",
        "production_readiness_status",
        "noop_receipt_status"
      ],
      "properties": {
        "candidate_matrix_status": {
          "$ref": "#/$defs/statusValue"
        },
        "preflight_contracts_status": {
          "$ref": "#/$defs/statusValue"
        },
        "preflight_proof_packages_status": {
          "$ref": "#/$defs/statusValue"
        },
        "readiness_rollup_status": {
          "$ref": "#/$defs/statusValue"
        },
        "dry_run_plan_status": {
          "$ref": "#/$defs/statusValue"
        },
        "dry_run_receipt_contract_status": {
          "$ref": "#/$defs/statusValue"
        },
        "blocked_unissued_receipt_status": {
          "$ref": "#/$defs/statusValue"
        },
        "production_readiness_status": {
          "$ref": "#/$defs/statusValue"
        },
        "noop_receipt_status": {
          "$ref": "#/$defs/statusValue"
        }
      }
    },
    "prerequisite_checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_entry_present",
        "preflight_contract_present",
        "preflight_proof_package_present",
        "readiness_rollup_present",
        "dry_run_plan_present",
        "dry_run_receipt_contract_present",
        "blocked_unissued_receipt_example_present",
        "production_readiness_report_present",
        "noop_receipt_status_present",
        "source_artifact_validations_pass",
        "approval_decision_present",
        "dry_run_runner_admitted",
        "dry_run_executed",
        "dry_run_receipt_issued",
        "rollback_cleanup_evidence_present",
        "publication_surfaces_blocked",
        "execution_surfaces_blocked",
        "production_ready_claimed"
      ],
      "properties": {
        "candidate_matrix_entry_present": { "type": "boolean" },
        "preflight_contract_present": { "type": "boolean" },
        "preflight_proof_package_present": { "type": "boolean" },
        "readiness_rollup_present": { "type": "boolean" },
        "dry_run_plan_present": { "type": "boolean" },
        "dry_run_receipt_contract_present": { "type": "boolean" },
        "blocked_unissued_receipt_example_present": { "type": "boolean" },
        "production_readiness_report_present": { "type": "boolean" },
        "noop_receipt_status_present": { "type": "boolean" },
        "source_artifact_validations_pass": { "type": "boolean" },
        "approval_decision_present": { "type": "boolean" },
        "dry_run_runner_admitted": { "type": "boolean" },
        "dry_run_executed": { "type": "boolean" },
        "dry_run_receipt_issued": { "type": "boolean" },
        "rollback_cleanup_evidence_present": { "type": "boolean" },
        "publication_surfaces_blocked": { "type": "boolean" },
        "execution_surfaces_blocked": { "type": "boolean" },
        "production_ready_claimed": { "type": "boolean" }
      }
    },
    "admission_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "approval_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "evidence_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "receipt_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "rollback_or_cleanup_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "safety_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "publication_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "execution_blockers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "ready_to_request_approval": {
      "type": "boolean",
      "const": false
    },
    "approval_phrase_required": {
      "type": "string",
      "const": "APPROVE EXECUTION ADMISSION release_candidate_package_publish_dry_run_v1"
    },
    "approval_decision_reference": {
      "type": ["null", "string"],
      "minLength": 0
    },
    "safest_next_action": {
      "type": "string",
      "minLength": 1
    },
    "unsafe_claims_detected": {
      "type": "boolean",
      "const": false
    },
    "claim_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uuid_status",
        "asset_id_status",
        "product_id_status"
      ],
      "properties": {
        "source_uuid_status": {
          "type": "string",
          "const": "not_authoritative"
        },
        "asset_id_status": {
          "type": "string",
          "const": "not_authoritative"
        },
        "product_id_status": {
          "type": "string",
          "const": "not_authoritative"
        }
      }
    },
    "safety_notes": {
      "$ref": "#/$defs/nonEmptyStringArray"
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statusValue": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    }
  },
  "allOf": [
    {
      "properties": {
        "admission_blockers": {
          "contains": { "const": "missing_approval_decision" }
        }
      }
    },
    {
      "properties": {
        "admission_blockers": {
          "contains": { "const": "dry_run_not_admitted" }
        }
      }
    },
    {
      "properties": {
        "admission_blockers": {
          "contains": { "const": "dry_run_not_executed" }
        }
      }
    },
    {
      "properties": {
        "admission_blockers": {
          "contains": { "const": "receipt_not_issued" }
        }
      }
    },
    {
      "properties": {
        "admission_blockers": {
          "contains": { "const": "rollback_cleanup_evidence_missing" }
        }
      }
    },
    {
      "properties": {
        "admission_blockers": {
          "contains": { "const": "publication_surfaces_blocked_by_policy" }
        }
      }
    },
    {
      "properties": {
        "publication_blockers": {
          "contains": { "const": "publication_surfaces_blocked_by_policy" }
        }
      }
    },
    {
      "properties": {
        "execution_blockers": {
          "contains": { "const": "dry_run_not_admitted" }
        }
      }
    }
  ]
}
