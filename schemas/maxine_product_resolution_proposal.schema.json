{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_product_resolution_proposal.schema.json",
  "title": "Maxine Product Resolution Proposal",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "proposal_id",
    "source_review_packet_id",
    "source_inventory_id",
    "source_project_inventory_id",
    "candidate_id",
    "project_root",
    "sandbox_root",
    "candidate_relative_path",
    "candidate_extension",
    "candidate_category",
    "candidate_sha256",
    "proposal_status",
    "expected_product_classes",
    "likely_asset_pipeline_requirements",
    "required_next_evidence",
    "blocking_reasons",
    "warnings",
    "proposal_only",
    "product_ids_claimed",
    "asset_ids_claimed",
    "source_uuids_claimed",
    "asset_processor_execution_admitted",
    "o3de_execution_admitted",
    "cache_access_admitted",
    "spawn_admitted",
    "publish_admitted",
    "safety_summary",
    "explicit_non_admissions",
    "output_path",
    "created_utc"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "source_review_packet_id": { "type": "string", "minLength": 1 },
    "source_inventory_id": { "type": "string", "minLength": 1 },
    "source_project_inventory_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "project_root": { "type": "string", "minLength": 1 },
    "sandbox_root": { "type": "string", "const": "examples/sandbox" },
    "candidate_relative_path": { "type": "string", "minLength": 1 },
    "candidate_extension": { "type": "string", "minLength": 1 },
    "candidate_category": {
      "type": "string",
      "enum": [
        "character_source",
        "mesh_source",
        "scene_source",
        "material_source",
        "texture_source",
        "metadata_source",
        "unknown_source"
      ]
    },
    "candidate_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "proposal_status": {
      "type": "string",
      "enum": [
        "proposal_only",
        "blocked_missing_evidence",
        "ready_for_read_only_ap_evidence_import",
        "rejected"
      ]
    },
    "expected_product_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "model_product_candidate",
          "actor_product_candidate",
          "motion_product_candidate",
          "material_product_candidate",
          "texture_product_candidate",
          "prefab_product_candidate",
          "unknown_product_candidate"
        ]
      },
      "minItems": 1
    },
    "likely_asset_pipeline_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_next_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocking_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "proposal_only": { "type": "boolean", "const": true },
    "product_ids_claimed": { "type": "boolean", "const": false },
    "asset_ids_claimed": { "type": "boolean", "const": false },
    "source_uuids_claimed": { "type": "boolean", "const": false },
    "asset_processor_execution_admitted": { "type": "boolean", "const": false },
    "o3de_execution_admitted": { "type": "boolean", "const": false },
    "cache_access_admitted": { "type": "boolean", "const": false },
    "spawn_admitted": { "type": "boolean", "const": false },
    "publish_admitted": { "type": "boolean", "const": false },
    "safety_summary": { "type": "string", "minLength": 1 },
    "explicit_non_admissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "output_path": { "type": "string", "minLength": 1 },
    "created_utc": { "type": "string", "minLength": 1 },
    "operator_id": { "type": ["string", "null"] },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
