{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_animation_smoke_report.schema.json",
  "title": "MAXINE Animation Smoke Report",
  "description": "Evidence-only animation smoke report contract for release-lane readiness.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "job_id",
    "package_id",
    "lane",
    "candidate_id",
    "source_asset_reference",
    "source_evidence_ref",
    "animation_profile_id",
    "animation_profile_version",
    "evidence_class",
    "actor_asset_reference",
    "motion_asset_reference",
    "skeleton_profile_id",
    "skeleton_compatibility_status",
    "root_motion_status",
    "bind_pose_compatibility_status",
    "clip_count",
    "smoke_clip_names",
    "clip_duration_status",
    "missing_clip_status",
    "retarget_readiness_status",
    "frame_range_status",
    "animation_budget_status",
    "claim_status",
    "safety",
    "status",
    "source",
    "smoke_profile",
    "animation_summary",
    "findings",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "ANIMATION_SMOKE_v1_REPORT"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_asset_reference": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "animation_profile_id": {
      "type": "string",
      "const": "ANIMATION_SMOKE_v1"
    },
    "animation_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "fixture",
        "imported",
        "controlled_real"
      ]
    },
    "actor_asset_reference": {
      "type": "string",
      "minLength": 1
    },
    "motion_asset_reference": {
      "type": "string",
      "minLength": 1
    },
    "motion_set_reference": {
      "type": "string",
      "minLength": 1
    },
    "anim_graph_reference": {
      "type": "string",
      "minLength": 1
    },
    "skeleton_profile_id": {
      "type": "string",
      "const": "MAX_BIPED_v1"
    },
    "skeleton_compatibility_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "root_motion_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "bind_pose_compatibility_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "clip_count": {
      "type": "integer",
      "minimum": 0
    },
    "smoke_clip_names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clip_duration_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "missing_clip_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "retarget_readiness_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "loopability_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "motion_event_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "frame_range_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "animation_budget_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "evidence_only",
        "not_authoritative"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "dcc_execution_status",
        "blender_execution_status",
        "o3de_execution_status",
        "asset_processor_execution_status",
        "runtime_playback_status",
        "production_write_status"
      ],
      "properties": {
        "dcc_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "blender_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "o3de_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "asset_processor_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "runtime_playback_status": {
          "type": "string",
          "const": "blocked"
        },
        "production_write_status": {
          "type": "string",
          "const": "blocked"
        }
      }
    },
    "status": {
      "$ref": "#/$defs/checkStatus"
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_path",
        "source_kind"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "smoke_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "smoke_contract_id",
        "target_skeleton_contract_id",
        "package_tier",
        "evidence_only",
        "runtime_execution_admitted"
      ],
      "properties": {
        "smoke_contract_id": {
          "type": "string",
          "const": "ANIMATION_SMOKE_v1"
        },
        "target_skeleton_contract_id": {
          "type": "string",
          "const": "MAX_BIPED_v1"
        },
        "package_tier": {
          "type": "string",
          "enum": [
            "draft",
            "npc",
            "hero",
            "test",
            "unknown"
          ]
        },
        "evidence_only": {
          "type": "boolean",
          "const": true
        },
        "runtime_execution_admitted": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "animation_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "required_clips",
        "present_clips",
        "missing_clips",
        "clip_count",
        "loop_playback_status",
        "pose_stability_status",
        "root_motion_status"
      ],
      "properties": {
        "required_clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "present_clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clip_count": {
          "type": "integer",
          "minimum": 0
        },
        "loop_playback_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "unknown"
          ]
        },
        "pose_stability_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "unknown"
          ]
        },
        "root_motion_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "unknown"
          ]
        },
        "warning_status_values": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warn",
              "unknown"
            ]
          },
          "default": [
            "warn",
            "unknown"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "manual_review"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "const": "qc.gates[]"
        },
        "future_target_path": {
          "type": "string",
          "const": "qc.checks[]"
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "const": "animation_smoke_v1"
            },
            "result": {
              "$ref": "#/$defs/checkStatus"
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "manual_review"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  },
  "$defs": {
    "checkStatus": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "pending_manual"
      ]
    }
  }
}
