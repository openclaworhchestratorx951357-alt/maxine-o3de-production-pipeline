{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_animation_smoke_report.schema.json",
  "title": "MAXINE Animation Smoke Report",
  "description": "Evidence-only animation smoke report contract for release-lane readiness.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "job_id",
    "package_id",
    "lane",
    "status",
    "source",
    "smoke_profile",
    "animation_summary",
    "findings",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "ANIMATION_SMOKE_v1_REPORT"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "pending_manual"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_path",
        "source_kind"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "smoke_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "smoke_contract_id",
        "target_skeleton_contract_id",
        "package_tier",
        "evidence_only",
        "runtime_execution_admitted"
      ],
      "properties": {
        "smoke_contract_id": {
          "type": "string",
          "const": "ANIMATION_SMOKE_v1"
        },
        "target_skeleton_contract_id": {
          "type": "string",
          "const": "MAX_BIPED_v1"
        },
        "package_tier": {
          "type": "string",
          "enum": [
            "draft",
            "npc",
            "hero",
            "test",
            "unknown"
          ]
        },
        "evidence_only": {
          "type": "boolean",
          "const": true
        },
        "runtime_execution_admitted": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "animation_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "required_clips",
        "present_clips",
        "missing_clips",
        "clip_count",
        "loop_playback_status",
        "pose_stability_status",
        "root_motion_status"
      ],
      "properties": {
        "required_clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "present_clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_clips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clip_count": {
          "type": "integer",
          "minimum": 0
        },
        "loop_playback_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "unknown"
          ]
        },
        "pose_stability_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "unknown"
          ]
        },
        "root_motion_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "unknown"
          ]
        },
        "warning_status_values": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "warn",
              "unknown"
            ]
          },
          "default": [
            "warn",
            "unknown"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "manual_review"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "future_target_path": {
          "type": "string",
          "minLength": 1
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "warn",
                "fail",
                "pending_manual"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "manual_review"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
