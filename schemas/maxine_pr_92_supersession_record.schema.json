{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_pr_92_supersession_record.schema.json",
  "title": "MAXINE PR 92 Supersession Record v1",
  "description": "Governance record that marks PR #92 as superseded by the PR #95 static command-envelope boundary hardening unless revised to match that boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "record_version",
    "superseded_pr",
    "superseding_pr",
    "audit_pr",
    "supersession_status",
    "supersession_recommendation",
    "pr_92_merge_allowed",
    "pr_92_close_recommended",
    "pr_92_revision_allowed",
    "pr_92_safe_to_merge_without_revision",
    "required_revision_conditions",
    "safety_posture",
    "command_pack_boundary_status",
    "forbidden_interpretations",
    "required_future_routing",
    "validation_summary",
    "unsafe_claims_detected",
    "final_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "PR_92_SUPERSESSION_RECORD_v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "record_version": {
      "type": "string",
      "const": "v1"
    },
    "superseded_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "pr_number",
        "title",
        "url",
        "head_branch",
        "base_branch",
        "head_sha_at_record_time",
        "state_at_record_time",
        "merged_at_record_time",
        "changed_since_pr94_audit"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "const": "openclaworhchestratorx951357-alt/maxine-o3de-production-pipeline"
        },
        "pr_number": {
          "type": "integer",
          "const": 92
        },
        "title": {
          "type": "string",
          "const": "Add natural language O3DE control command pack v1"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "head_branch": {
          "type": "string",
          "const": "codex/nl-o3de-control-pack-v1"
        },
        "base_branch": {
          "type": "string",
          "const": "main"
        },
        "head_sha_at_record_time": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "state_at_record_time": {
          "type": "string",
          "enum": ["open", "closed"]
        },
        "merged_at_record_time": {
          "type": "boolean",
          "const": false
        },
        "changed_since_pr94_audit": {
          "type": "boolean"
        }
      }
    },
    "superseding_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_number", "title", "url", "merge_commit"],
      "properties": {
        "pr_number": {
          "type": "integer",
          "const": 95
        },
        "title": {
          "type": "string",
          "const": "Harden PR 92 natural language command pack boundaries v1"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "merge_commit": {
          "type": "string",
          "const": "ddc787c2eacf9409bf66f69f5813845e6a989c6e"
        }
      }
    },
    "audit_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_number",
        "title",
        "url",
        "merge_commit",
        "audit_status",
        "merge_recommendation"
      ],
      "properties": {
        "pr_number": {
          "type": "integer",
          "const": 94
        },
        "title": {
          "type": "string",
          "const": "Audit PR 92 natural language command pack boundaries v1"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "merge_commit": {
          "type": "string",
          "const": "d55ca160ae96cc37e984799c90bb7580ddcacfd4"
        },
        "audit_status": {
          "type": "string",
          "const": "audit_complete_block_merge_pending_hardening"
        },
        "merge_recommendation": {
          "type": "string",
          "const": "do_not_merge_yet"
        }
      }
    },
    "supersession_status": {
      "type": "string",
      "enum": [
        "active_supersession_record",
        "supersession_record_invalid",
        "superseded_by_newer_record"
      ]
    },
    "supersession_recommendation": {
      "type": "string",
      "enum": [
        "close_pr_92_as_superseded",
        "revise_pr_92_to_match_pr_95_before_reconsideration",
        "hold_pr_92_do_not_merge",
        "superseded_by_pr_95"
      ]
    },
    "pr_92_merge_allowed": {
      "type": "boolean",
      "const": false
    },
    "pr_92_close_recommended": {
      "type": "boolean",
      "const": true
    },
    "pr_92_revision_allowed": {
      "type": "boolean",
      "const": true
    },
    "pr_92_safe_to_merge_without_revision": {
      "type": "boolean",
      "const": false
    },
    "required_revision_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "safety_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_o3de_execution",
        "runner_implemented",
        "gem_adapter_implemented",
        "command_admitted",
        "dry_run_admitted",
        "real_execution_admitted",
        "publication_admitted",
        "production_ready_claimed",
        "blocked_surfaces_preserved"
      ],
      "properties": {
        "direct_o3de_execution": {
          "type": "boolean",
          "const": false
        },
        "runner_implemented": {
          "type": "boolean",
          "const": false
        },
        "gem_adapter_implemented": {
          "type": "boolean",
          "const": false
        },
        "command_admitted": {
          "type": "boolean",
          "const": false
        },
        "dry_run_admitted": {
          "type": "boolean",
          "const": false
        },
        "real_execution_admitted": {
          "type": "boolean",
          "const": false
        },
        "publication_admitted": {
          "type": "boolean",
          "const": false
        },
        "production_ready_claimed": {
          "type": "boolean",
          "const": false
        },
        "blocked_surfaces_preserved": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "command_pack_boundary_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_95_boundary_ref",
        "command_envelope_static_only",
        "compiler_parser_static_only",
        "validator_static_only",
        "unsafe_commands_fail_closed",
        "sandbox_output_path_checks_fail_closed"
      ],
      "properties": {
        "pr_95_boundary_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command_envelope_static_only": {
          "type": "boolean",
          "const": true
        },
        "compiler_parser_static_only": {
          "type": "boolean",
          "const": true
        },
        "validator_static_only": {
          "type": "boolean",
          "const": true
        },
        "unsafe_commands_fail_closed": {
          "type": "boolean",
          "const": true
        },
        "sandbox_output_path_checks_fail_closed": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "forbidden_interpretations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "required_future_routing": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_94_audit_validator_status",
        "pr_95_command_pack_validator_status",
        "runner_interface_validator_status",
        "sandbox_boundary_validator_status",
        "safety_verifier_status",
        "proof_flow_status",
        "production_readiness_gate_status"
      ],
      "properties": {
        "pr_94_audit_validator_status": {
          "type": "string",
          "const": "pass"
        },
        "pr_95_command_pack_validator_status": {
          "type": "string",
          "const": "pass"
        },
        "runner_interface_validator_status": {
          "type": "string",
          "const": "pass"
        },
        "sandbox_boundary_validator_status": {
          "type": "string",
          "const": "pass"
        },
        "safety_verifier_status": {
          "type": "string",
          "const": "pass"
        },
        "proof_flow_status": {
          "type": "string",
          "const": "pass"
        },
        "production_readiness_gate_status": {
          "type": "string",
          "const": "blocked_for_execution"
        }
      }
    },
    "unsafe_claims_detected": {
      "type": "boolean",
      "const": false
    },
    "final_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
