{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_material_uv_qc_report.schema.json",
  "title": "MAXINE Material UV QC Report",
  "description": "Evidence-only material/UV QC report contract for release-lane readiness.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "job_id",
    "package_id",
    "lane",
    "status",
    "source",
    "target",
    "material_summary",
    "uv_summary",
    "texture_budget",
    "findings",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "MATERIAL_UV_QC_v1_REPORT"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "pending_manual"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_path",
        "source_kind"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_tier",
        "material_profile"
      ],
      "properties": {
        "package_tier": {
          "type": "string",
          "enum": [
            "draft",
            "npc",
            "hero",
            "test",
            "unknown"
          ]
        },
        "material_profile": {
          "type": "string",
          "enum": [
            "StandardPBR",
            "unknown",
            "custom"
          ]
        }
      }
    },
    "material_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "material_slot_count",
        "material_slot_budget",
        "missing_materials",
        "unsupported_materials",
        "texture_references",
        "missing_textures"
      ],
      "properties": {
        "material_slot_count": {
          "type": "integer",
          "minimum": 0
        },
        "material_slot_budget": {
          "type": "integer",
          "minimum": 0
        },
        "slot_budget_exceeded_severity": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "manual_review"
          ],
          "default": "warning"
        },
        "missing_materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupported_materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "texture_references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "material_slot",
              "texture_path",
              "texture_kind"
            ],
            "properties": {
              "material_slot": {
                "type": "string",
                "minLength": 1
              },
              "texture_path": {
                "type": "string",
                "minLength": 1
              },
              "texture_kind": {
                "type": "string",
                "minLength": 1
              },
              "resolution": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "missing_textures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "uv_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "required_uv_sets",
        "present_uv_sets",
        "missing_uv_sets",
        "overlapping_uvs_status",
        "out_of_bounds_uvs_status"
      ],
      "properties": {
        "required_uv_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "present_uv_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_uv_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlapping_uvs_status": {
          "type": "string",
          "enum": [
            "none",
            "minor",
            "major",
            "unknown"
          ]
        },
        "out_of_bounds_uvs_status": {
          "type": "string",
          "enum": [
            "none",
            "minor",
            "major",
            "unknown"
          ]
        }
      }
    },
    "texture_budget": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "max_texture_resolution",
        "oversized_textures",
        "texture_count"
      ],
      "properties": {
        "max_texture_resolution": {
          "type": "integer",
          "minimum": 1
        },
        "oversized_textures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "texture_path",
              "actual_resolution"
            ],
            "properties": {
              "texture_path": {
                "type": "string",
                "minLength": 1
              },
              "actual_resolution": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "oversized_textures_severity": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "manual_review"
          ],
          "default": "warning"
        },
        "texture_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "manual_review"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "future_target_path": {
          "type": "string",
          "minLength": 1
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "warn",
                "fail",
                "pending_manual"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "manual_review"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
