{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_screenshot_evidence_report.schema.json",
  "title": "MAXINE Screenshot Evidence Report",
  "description": "Evidence-only screenshot capture report contract for release-lane readiness.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "job_id",
    "package_id",
    "lane",
    "status",
    "source",
    "capture_profile",
    "screenshot_summary",
    "findings",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "SCREENSHOT_EVIDENCE_v1_REPORT"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "pending_manual"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_path",
        "source_kind"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capture_profile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "capture_contract_id",
        "target_skeleton_contract_id",
        "required_view_ids",
        "evidence_only",
        "runtime_execution_admitted",
        "min_width",
        "min_height",
        "low_resolution_severity"
      ],
      "properties": {
        "capture_contract_id": {
          "type": "string",
          "const": "SCREENSHOT_EVIDENCE_v1"
        },
        "target_skeleton_contract_id": {
          "type": "string",
          "const": "MAX_BIPED_v1"
        },
        "required_view_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_only": {
          "type": "boolean",
          "const": true
        },
        "runtime_execution_admitted": {
          "type": "boolean",
          "const": false
        },
        "min_width": {
          "type": "integer",
          "minimum": 1
        },
        "min_height": {
          "type": "integer",
          "minimum": 1
        },
        "low_resolution_severity": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "manual_review"
          ]
        }
      }
    },
    "screenshot_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "captured_view_ids",
        "missing_view_ids",
        "screenshot_paths",
        "invalid_screenshot_paths"
      ],
      "properties": {
        "captured_view_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_view_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "screenshot_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "view_id",
              "path",
              "width",
              "height",
              "format"
            ],
            "properties": {
              "view_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpg",
                  "jpeg"
                ]
              }
            }
          }
        },
        "invalid_screenshot_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "manual_review"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "future_target_path": {
          "type": "string",
          "minLength": 1
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "warn",
                "fail",
                "pending_manual"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "manual_review"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
