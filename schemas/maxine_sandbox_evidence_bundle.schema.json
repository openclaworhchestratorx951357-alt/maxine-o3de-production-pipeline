{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_sandbox_evidence_bundle.schema.json",
  "title": "Maxine Sandbox Evidence Bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "bundle_id",
    "source_workflow_run_id",
    "source_receipt_id",
    "source_review_packet_id",
    "source_decision_id",
    "sandbox_root",
    "bundle_path",
    "included_artifacts",
    "copied_artifact_paths",
    "artifact_sha256",
    "safety_summary",
    "explicit_non_admissions",
    "created_utc"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "source_workflow_run_id": { "type": "string", "minLength": 1 },
    "source_receipt_id": { "type": ["string", "null"] },
    "source_review_packet_id": { "type": ["string", "null"] },
    "source_decision_id": { "type": ["string", "null"] },
    "sandbox_root": { "type": "string", "const": "examples/sandbox" },
    "bundle_path": { "type": "string", "minLength": 1 },
    "included_artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "copied_artifact_paths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "artifact_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    },
    "safety_summary": { "type": "string", "minLength": 1 },
    "explicit_non_admissions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "created_utc": { "type": "string", "minLength": 1 }
  }
}
