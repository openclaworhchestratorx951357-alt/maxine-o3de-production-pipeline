{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_natural_language_o3de_command_envelope.schema.json",
  "title": "MAXINE Natural Language O3DE Command Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "command_id",
    "command_version",
    "natural_language_request",
    "normalized_intent",
    "command_envelope_status",
    "command_admission_status",
    "execution_mode",
    "refusal_reason_code",
    "runner_required",
    "runner_interface_required",
    "runner_implemented",
    "runner_admitted",
    "runner_executed",
    "sandbox_boundary_required",
    "sandbox_boundary_validation_required",
    "receipt_contract_required",
    "receipt_contract_validation_required",
    "candidate_admission_required",
    "execution_admitted",
    "publication_admitted",
    "production_ready_claimed",
    "approval_required",
    "approval_phrase_present",
    "approval_decision_ref",
    "planned_actions",
    "allowed_static_operations",
    "forbidden_actions",
    "source_artifacts",
    "source_artifact_validation_status",
    "required_admission_gates",
    "output_contract",
    "safety_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "NATURAL_LANGUAGE_O3DE_COMMAND_ENVELOPE_v1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "command_version": {
      "type": "string",
      "const": "v1"
    },
    "natural_language_request": {
      "type": "string",
      "minLength": 1
    },
    "normalized_intent": {
      "type": "string",
      "enum": [
        "static_read_only",
        "static_evidence_only",
        "future_noop_receipt",
        "future_publication_dry_run",
        "future_real_execution",
        "future_publication",
        "unsupported_or_unsafe"
      ]
    },
    "command_envelope_status": {
      "type": "string",
      "enum": [
        "static_envelope_valid",
        "static_envelope_blocked"
      ]
    },
    "command_admission_status": {
      "type": "string",
      "enum": [
        "unadmitted",
        "blocked"
      ]
    },
    "execution_mode": {
      "type": "string"
    },
    "refusal_reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "runner_required": {
      "type": "boolean"
    },
    "runner_interface_required": {
      "type": "boolean"
    },
    "runner_implemented": {
      "type": "boolean",
      "const": false
    },
    "runner_admitted": {
      "type": "boolean",
      "const": false
    },
    "runner_executed": {
      "type": "boolean",
      "const": false
    },
    "sandbox_boundary_required": {
      "type": "boolean"
    },
    "sandbox_boundary_validation_required": {
      "type": "boolean"
    },
    "receipt_contract_required": {
      "type": "boolean"
    },
    "receipt_contract_validation_required": {
      "type": "boolean"
    },
    "candidate_admission_required": {
      "type": "boolean"
    },
    "execution_admitted": {
      "type": "boolean",
      "const": false
    },
    "publication_admitted": {
      "type": "boolean",
      "const": false
    },
    "production_ready_claimed": {
      "type": "boolean",
      "const": false
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_phrase_present": {
      "type": "boolean",
      "const": false
    },
    "approval_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_actions": {
      "type": "array",
      "maxItems": 0
    },
    "allowed_static_operations": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_artifact_validation_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "const": "pass"
      }
    },
    "required_admission_gates": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox_only",
        "allowed_output_roots",
        "planned_outputs",
        "allowed_extensions",
        "forbidden_extensions"
      ],
      "properties": {
        "sandbox_only": {
          "type": "boolean",
          "const": true
        },
        "allowed_output_roots": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "planned_outputs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "allowed_extensions": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "forbidden_extensions": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "safety_notes": {
      "$ref": "#/$defs/non_empty_string_array"
    }
  },
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
