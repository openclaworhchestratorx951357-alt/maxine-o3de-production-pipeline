{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_sandbox_workflow_run.schema.json",
  "title": "Maxine Sandbox Workflow Run",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "workflow_run_id",
    "workflow_mode",
    "input_plan_path",
    "sandbox_root",
    "receipt_id",
    "receipt_path",
    "review_packet_id",
    "review_packet_path",
    "decision_id",
    "decision_path",
    "decision_state",
    "requested_next_action",
    "rollback_execution_admitted",
    "workflow_status",
    "blocked_reason",
    "files_written",
    "explicit_non_admissions",
    "timestamp_utc",
    "completed_utc"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "workflow_run_id": { "type": "string", "minLength": 1 },
    "workflow_mode": {
      "type": "string",
      "enum": [
        "WriteOnly",
        "WriteAndReview",
        "WriteReviewAndDecision",
        "RollbackRequestedOnly"
      ]
    },
    "input_plan_path": { "type": "string", "minLength": 1 },
    "sandbox_root": { "type": "string", "const": "examples/sandbox" },
    "receipt_id": { "type": ["string", "null"] },
    "receipt_path": { "type": ["string", "null"] },
    "review_packet_id": { "type": ["string", "null"] },
    "review_packet_path": { "type": ["string", "null"] },
    "decision_id": { "type": ["string", "null"] },
    "decision_path": { "type": ["string", "null"] },
    "decision_state": { "type": ["string", "null"] },
    "requested_next_action": { "type": ["string", "null"] },
    "rollback_execution_admitted": { "type": "boolean", "const": false },
    "workflow_status": { "type": "string", "enum": ["completed", "blocked"] },
    "blocked_reason": { "type": ["string", "null"] },
    "files_written": {
      "type": "array",
      "items": { "type": "string" }
    },
    "explicit_non_admissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "timestamp_utc": { "type": "string", "minLength": 1 },
    "completed_utc": { "type": "string", "minLength": 1 }
  }
}
