{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_execution_publication_admission_plan.schema.json",
  "title": "MAXINE Execution Publication Admission Plan v1",
  "description": "Review-only planning contract for narrow future execution/publication admission candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "plan_id",
    "plan_version",
    "status",
    "generated_for_branch_or_commit",
    "current_readiness",
    "candidate",
    "scope",
    "allowed_inputs",
    "allowed_outputs",
    "blocked_inputs",
    "blocked_outputs",
    "approval",
    "required_preconditions",
    "required_postconditions",
    "receipt_fields",
    "rollback_readiness_requirements",
    "safety_verifier_requirements",
    "post_execution_validation_requirements",
    "reasons_broad_execution_still_blocked",
    "claim_status",
    "no_admission_in_this_slice"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "EXECUTION_PUBLICATION_ADMISSION_PLAN_v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "string",
      "const": "v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "review_only",
        "blocked"
      ]
    },
    "generated_for_branch_or_commit": {
      "type": "string",
      "minLength": 1
    },
    "current_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_readiness_level",
        "readiness_decision",
        "execution_admission_status",
        "publication_admission_status",
        "execution_admission_admitted",
        "publication_admission_admitted"
      ],
      "properties": {
        "production_readiness_level": {
          "type": "string",
          "enum": [
            "evidence_ready",
            "review_ready",
            "execution_ready",
            "production_ready",
            "blocked"
          ]
        },
        "readiness_decision": {
          "type": "string",
          "enum": [
            "pass_evidence_only",
            "warn_evidence_only",
            "blocked_for_execution",
            "blocked_for_publication",
            "fail"
          ]
        },
        "execution_admission_status": {
          "type": "string",
          "const": "blocked"
        },
        "publication_admission_status": {
          "type": "string",
          "const": "blocked"
        },
        "execution_admission_admitted": {
          "type": "boolean",
          "const": false
        },
        "publication_admission_admitted": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_title",
        "candidate_status"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "const": "release_candidate_package_receipt_noop_v1"
        },
        "candidate_title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_status": {
          "type": "string",
          "enum": [
            "proposed",
            "review_only",
            "blocked"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_op_receipt_generation_only",
        "local_repo_evidence_inputs_only",
        "sandbox_example_outputs_only",
        "execution_or_publication_admitted"
      ],
      "properties": {
        "no_op_receipt_generation_only": {
          "type": "boolean",
          "const": true
        },
        "local_repo_evidence_inputs_only": {
          "type": "boolean",
          "const": true
        },
        "sandbox_example_outputs_only": {
          "type": "boolean",
          "const": true
        },
        "execution_or_publication_admitted": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "allowed_inputs": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "allowed_outputs": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "blocked_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "o3de_execution",
          "editor_execution",
          "runtime_execution",
          "asset_processor_execution",
          "blender_or_dcc_execution",
          "profiler_or_benchmark_execution",
          "live_screenshot_capture",
          "spawn_or_publish_execution",
          "cache_or_live_db_access",
          "authoritative_source_uuid_claims",
          "authoritative_asset_id_claims",
          "authoritative_product_id_claims"
        ]
      }
    },
    "blocked_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "production_path_write",
          "engine_path_write",
          "spawn_or_publish_output"
        ]
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_phrase_format",
        "required_phrase_exact",
        "approval_received",
        "admission_approved_in_this_slice"
      ],
      "properties": {
        "required_phrase_format": {
          "type": "string",
          "const": "APPROVE EXECUTION ADMISSION <candidate_id>"
        },
        "required_phrase_exact": {
          "type": "string",
          "const": "APPROVE EXECUTION ADMISSION release_candidate_package_receipt_noop_v1"
        },
        "approval_received": {
          "type": "boolean",
          "const": false
        },
        "admission_approved_in_this_slice": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "required_preconditions": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "required_postconditions": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "receipt_fields": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "rollback_readiness_requirements": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "safety_verifier_requirements": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "post_execution_validation_requirements": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "reasons_broad_execution_still_blocked": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "claim_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uuid_status",
        "asset_id_status",
        "product_id_status"
      ],
      "properties": {
        "source_uuid_status": {
          "type": "string",
          "const": "not_authoritative"
        },
        "asset_id_status": {
          "type": "string",
          "const": "not_authoritative"
        },
        "product_id_status": {
          "type": "string",
          "const": "not_authoritative"
        }
      }
    },
    "no_admission_in_this_slice": {
      "type": "boolean",
      "const": true
    },
    "recommended_next_step": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "blocked_inputs": {
          "contains": {
            "const": "o3de_execution"
          }
        }
      }
    },
    {
      "properties": {
        "blocked_inputs": {
          "contains": {
            "const": "editor_execution"
          }
        }
      }
    },
    {
      "properties": {
        "blocked_inputs": {
          "contains": {
            "const": "runtime_execution"
          }
        }
      }
    },
    {
      "properties": {
        "blocked_inputs": {
          "contains": {
            "const": "asset_processor_execution"
          }
        }
      }
    },
    {
      "properties": {
        "blocked_inputs": {
          "contains": {
            "const": "blender_or_dcc_execution"
          }
        }
      }
    },
    {
      "properties": {
        "blocked_inputs": {
          "contains": {
            "const": "spawn_or_publish_execution"
          }
        }
      }
    },
    {
      "properties": {
        "blocked_outputs": {
          "contains": {
            "const": "production_path_write"
          }
        }
      }
    },
    {
      "properties": {
        "blocked_outputs": {
          "contains": {
            "const": "engine_path_write"
          }
        }
      }
    }
  ]
}

