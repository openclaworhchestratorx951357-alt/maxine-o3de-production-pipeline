{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_execution_admission_candidate_matrix.schema.json",
  "title": "MAXINE Execution Admission Candidate Matrix v1",
  "description": "Machine-readable candidate inventory for future execution/publication admissions. This contract is planning/status only and must not imply real execution or publication admission by default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "matrix_id",
    "matrix_version",
    "generated_for_branch_or_commit",
    "approval_phrase_format",
    "candidate_types",
    "candidate_statuses",
    "production_ready_claimed",
    "real_execution_admission_status",
    "publication_admission_status",
    "admitted_noop_receipt_candidate_ids",
    "receipt_backed_candidate_ids",
    "admitted_real_execution_candidate_ids",
    "admitted_publication_candidate_ids",
    "candidates",
    "claim_status",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "EXECUTION_ADMISSION_CANDIDATE_MATRIX_v1"
    },
    "matrix_id": {
      "type": "string",
      "minLength": 1
    },
    "matrix_version": {
      "type": "string",
      "const": "v1"
    },
    "generated_for_branch_or_commit": {
      "type": "string",
      "minLength": 1
    },
    "approval_phrase_format": {
      "type": "string",
      "const": "APPROVE EXECUTION ADMISSION <candidate_id>"
    },
    "candidate_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "evidence_only",
          "no_op_receipt",
          "dry_run",
          "real_execution",
          "publication"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "candidate_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "proposed",
          "blocked",
          "review_ready",
          "admitted",
          "superseded",
          "rejected"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "production_ready_claimed": {
      "type": "boolean",
      "const": false
    },
    "real_execution_admission_status": {
      "type": "string",
      "enum": [
        "blocked",
        "admitted"
      ]
    },
    "publication_admission_status": {
      "type": "string",
      "enum": [
        "blocked",
        "admitted"
      ]
    },
    "admitted_noop_receipt_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "receipt_backed_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "admitted_real_execution_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "admitted_publication_candidate_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "evidence_only",
        "not_authoritative"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "o3de_execution_status",
        "editor_runtime_execution_status",
        "asset_processor_execution_status",
        "blender_dcc_execution_status",
        "profiler_benchmark_execution_status",
        "live_screenshot_capture_status",
        "spawn_publish_status",
        "cache_live_db_access_status",
        "production_write_status",
        "engine_write_status"
      ],
      "properties": {
        "o3de_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "editor_runtime_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "asset_processor_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "blender_dcc_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "profiler_benchmark_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "live_screenshot_capture_status": {
          "type": "string",
          "const": "blocked"
        },
        "spawn_publish_status": {
          "type": "string",
          "const": "blocked"
        },
        "cache_live_db_access_status": {
          "type": "string",
          "const": "blocked"
        },
        "production_write_status": {
          "type": "string",
          "const": "blocked"
        },
        "engine_write_status": {
          "type": "string",
          "const": "blocked"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "real_execution_admission_status": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_real_execution_candidate_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "real_execution_admission_status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_real_execution_candidate_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_admission_status": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_publication_candidate_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_admission_status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "admitted_publication_candidate_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "admitted_real_execution_candidate_ids": {
            "contains": {
              "const": "release_candidate_package_receipt_noop_v1"
            }
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "admitted_publication_candidate_ids": {
            "contains": {
              "const": "release_candidate_package_receipt_noop_v1"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blockedSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "o3de_execution",
          "editor_runtime_execution",
          "asset_processor_execution",
          "blender_dcc_execution",
          "profiler_benchmark_execution",
          "live_screenshot_capture",
          "spawn_publish",
          "cache_live_db_access",
          "authoritative_source_uuid_claims",
          "authoritative_asset_id_claims",
          "authoritative_product_id_claims",
          "production_write",
          "engine_write"
        ]
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_type",
        "current_status",
        "candidate_title",
        "intended_future_purpose",
        "requires_explicit_approval",
        "approval_phrase",
        "allowed_scope",
        "sandbox_boundary",
        "allowed_inputs",
        "expected_outputs",
        "blocked_surfaces",
        "evidence_requirements",
        "receipt_required",
        "receipt_requirements",
        "rollback_plan_required",
        "rollback_requirements",
        "validator_required",
        "tests_required",
        "validator_test_requirements",
        "production_readiness_relationship",
        "publication_relationship",
        "safety_notes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_type": {
          "type": "string",
          "enum": [
            "evidence_only",
            "no_op_receipt",
            "dry_run",
            "real_execution",
            "publication"
          ]
        },
        "current_status": {
          "type": "string",
          "enum": [
            "proposed",
            "blocked",
            "review_ready",
            "admitted",
            "superseded",
            "rejected"
          ]
        },
        "candidate_title": {
          "type": "string",
          "minLength": 1
        },
        "intended_future_purpose": {
          "type": "string",
          "minLength": 1
        },
        "requires_explicit_approval": {
          "type": "boolean"
        },
        "approval_phrase": {
          "type": "string",
          "pattern": "^APPROVE EXECUTION ADMISSION .+$"
        },
        "explicit_admission_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "allowed_scope": {
          "$ref": "#/$defs/stringArray"
        },
        "sandbox_boundary": {
          "type": "string",
          "minLength": 1
        },
        "allowed_inputs": {
          "$ref": "#/$defs/stringArray"
        },
        "expected_outputs": {
          "$ref": "#/$defs/stringArray"
        },
        "blocked_surfaces": {
          "$ref": "#/$defs/blockedSurfaces"
        },
        "evidence_requirements": {
          "$ref": "#/$defs/stringArray"
        },
        "receipt_required": {
          "type": "boolean"
        },
        "receipt_requirements": {
          "$ref": "#/$defs/stringArray"
        },
        "rollback_plan_required": {
          "type": "boolean"
        },
        "rollback_requirements": {
          "$ref": "#/$defs/stringArray"
        },
        "validator_required": {
          "type": "boolean"
        },
        "tests_required": {
          "type": "boolean"
        },
        "validator_test_requirements": {
          "$ref": "#/$defs/stringArray"
        },
        "production_readiness_relationship": {
          "type": "string",
          "minLength": 1
        },
        "publication_relationship": {
          "type": "string",
          "minLength": 1
        },
        "safety_notes": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "candidate_type": {
                "enum": [
                  "real_execution",
                  "publication"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "requires_explicit_approval": {
                "const": true
              },
              "receipt_required": {
                "const": true
              },
              "rollback_plan_required": {
                "const": true
              },
              "validator_required": {
                "const": true
              },
              "tests_required": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate_type": {
                "enum": [
                  "real_execution",
                  "publication"
                ]
              },
              "current_status": {
                "const": "admitted"
              }
            },
            "required": [
              "candidate_type",
              "current_status"
            ]
          },
          "then": {
            "required": [
              "explicit_admission_decision_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "candidate_id": {
                "const": "release_candidate_package_receipt_noop_v1"
              }
            },
            "required": [
              "candidate_id"
            ]
          },
          "then": {
            "properties": {
              "candidate_type": {
                "const": "no_op_receipt"
              }
            }
          }
        }
      ]
    }
  }
}
