{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_ci_artifact_retention_report.schema.json",
  "title": "MAXINE CI Artifact Retention Report",
  "description": "Evidence-only CI artifact retention and release-lane validation report contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "job_id",
    "package_id",
    "lane",
    "status",
    "source",
    "retention_policy",
    "artifact_inventory",
    "release_validation",
    "findings",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "CI_ARTIFACT_RETENTION_v1_REPORT"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "pending_manual"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_path",
        "source_kind"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "policy_id",
        "retention_class",
        "min_required_days",
        "actual_retention_days",
        "evidence_only",
        "runtime_execution_admitted"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "const": "CI_ARTIFACT_RETENTION_v1"
        },
        "retention_class": {
          "type": "string",
          "enum": [
            "draft-7d",
            "release-365d",
            "manual",
            "unknown"
          ]
        },
        "min_required_days": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_days": {
          "type": "integer",
          "minimum": 1
        },
        "actual_retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_only": {
          "type": "boolean",
          "const": true
        },
        "runtime_execution_admitted": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "artifact_inventory": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifact_root",
        "required_artifact_paths",
        "present_artifact_paths",
        "missing_artifacts",
        "disallowed_artifact_paths"
      ],
      "properties": {
        "artifact_root": {
          "type": "string",
          "minLength": 1
        },
        "required_artifact_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "present_artifact_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disallowed_artifact_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "release_validation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "required_qc_gate_ids",
        "present_qc_gate_ids",
        "missing_qc_gate_ids",
        "release_readiness_state",
        "manual_review_required"
      ],
      "properties": {
        "required_qc_gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "present_qc_gate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_qc_gate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "release_readiness_state": {
          "type": "string",
          "enum": [
            "ready_for_manual_release_review",
            "blocked_missing_evidence",
            "blocked_safety_boundary"
          ]
        },
        "manual_review_required": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "severity",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "manual_review"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "future_target_path": {
          "type": "string",
          "minLength": 1
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "warn",
                "fail",
                "pending_manual"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "manual_review"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
