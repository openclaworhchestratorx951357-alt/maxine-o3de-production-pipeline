{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_execution_admission_readiness_rollup.schema.json",
  "title": "MAXINE Execution Admission Readiness Rollup v1",
  "description": "Static control-tower rollup for execution-admission readiness posture. This artifact is reporting-only and must not imply execution/publication admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "rollup_id",
    "rollup_version",
    "generated_for_branch_or_commit",
    "generated_from_static_artifacts_only",
    "source_artifacts",
    "source_artifact_validation_status",
    "overall_readiness_rollup_status",
    "production_readiness_level",
    "readiness_decision",
    "production_ready_claimed",
    "no_op_receipt_status",
    "real_execution_admission_status",
    "publication_admission_status",
    "admitted_noop_receipt_candidate_ids",
    "admitted_real_execution_candidate_ids",
    "admitted_publication_candidate_ids",
    "blocked_real_execution_candidate_ids",
    "blocked_publication_candidate_ids",
    "blocked_dry_run_candidate_ids",
    "real_execution_preflight_passed_candidate_ids",
    "publication_preflight_passed_candidate_ids",
    "candidate_counts",
    "candidate_rollups",
    "missing_evidence_summary",
    "blocker_summary",
    "safest_next_preparation_slice",
    "unsafe_claims_detected",
    "approval_phrase_required",
    "claim_status",
    "safety",
    "safety_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "EXECUTION_ADMISSION_READINESS_ROLLUP_v1"
    },
    "rollup_id": {
      "type": "string",
      "minLength": 1
    },
    "rollup_version": {
      "type": "string",
      "const": "v1"
    },
    "generated_for_branch_or_commit": {
      "type": "string",
      "minLength": 1
    },
    "generated_from_static_artifacts_only": {
      "type": "boolean",
      "const": true
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_ref",
        "preflight_contracts_ref",
        "preflight_proof_packages_ref",
        "production_readiness_report_ref",
        "noop_receipt_admission_ref"
      ],
      "properties": {
        "candidate_matrix_ref": {
          "type": "string",
          "minLength": 1
        },
        "preflight_contracts_ref": {
          "type": "string",
          "minLength": 1
        },
        "preflight_proof_packages_ref": {
          "type": "string",
          "minLength": 1
        },
        "production_readiness_report_ref": {
          "type": "string",
          "minLength": 1
        },
        "noop_receipt_admission_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_artifact_validation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_status",
        "preflight_contracts_status",
        "preflight_proof_packages_status",
        "production_readiness_status",
        "noop_receipt_status"
      ],
      "properties": {
        "candidate_matrix_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "preflight_contracts_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "preflight_proof_packages_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "production_readiness_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "noop_receipt_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        }
      }
    },
    "overall_readiness_rollup_status": {
      "type": "string",
      "enum": [
        "static_rollup_valid_blocked",
        "static_rollup_invalid",
        "blocked_missing_artifact",
        "blocked_inconsistent_artifacts",
        "superseded"
      ]
    },
    "production_readiness_level": {
      "type": "string",
      "enum": [
        "evidence_ready",
        "review_ready",
        "execution_ready",
        "production_ready",
        "blocked",
        "receipt_ready"
      ]
    },
    "readiness_decision": {
      "type": "string",
      "enum": [
        "blocked_for_real_execution_and_publication",
        "blocked_for_execution",
        "blocked_for_publication",
        "blocked_for_execution_and_publication",
        "pass_evidence_only",
        "warn_evidence_only",
        "fail"
      ]
    },
    "production_ready_claimed": {
      "type": "boolean",
      "const": false
    },
    "no_op_receipt_status": {
      "type": "string",
      "enum": [
        "admitted_no_op_only",
        "blocked",
        "unknown"
      ]
    },
    "real_execution_admission_status": {
      "type": "string",
      "const": "blocked"
    },
    "publication_admission_status": {
      "type": "string",
      "const": "blocked"
    },
    "admitted_noop_receipt_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "release_candidate_package_receipt_noop_v1"
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "admitted_real_execution_candidate_ids": {
      "$ref": "#/$defs/emptyStringArray"
    },
    "admitted_publication_candidate_ids": {
      "$ref": "#/$defs/emptyStringArray"
    },
    "blocked_real_execution_candidate_ids": {
      "type": "array",
      "const": [
        "dcc_conform_execution_v1",
        "asset_processor_batch_execution_v1",
        "max_biped_skeleton_validation_execution_v1",
        "material_uv_qc_execution_v1",
        "animation_smoke_execution_v1",
        "visual_evidence_capture_execution_v1"
      ]
    },
    "blocked_publication_candidate_ids": {
      "type": "array",
      "const": [
        "release_candidate_package_publication_v1"
      ]
    },
    "blocked_dry_run_candidate_ids": {
      "type": "array",
      "const": [
        "release_candidate_package_publish_dry_run_v1"
      ]
    },
    "real_execution_preflight_passed_candidate_ids": {
      "$ref": "#/$defs/emptyStringArray"
    },
    "publication_preflight_passed_candidate_ids": {
      "$ref": "#/$defs/emptyStringArray"
    },
    "candidate_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_candidates",
        "no_op_receipt_candidates",
        "real_execution_candidates",
        "publication_candidates",
        "dry_run_candidates",
        "admitted_no_op_only_candidates",
        "admitted_real_execution_candidates",
        "admitted_publication_candidates",
        "blocked_real_execution_candidates",
        "blocked_publication_candidates",
        "blocked_dry_run_candidates"
      ],
      "properties": {
        "total_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "no_op_receipt_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "real_execution_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "publication_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "dry_run_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "admitted_no_op_only_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "admitted_real_execution_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "admitted_publication_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "blocked_real_execution_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_publication_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_dry_run_candidates": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidate_rollups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidateRollup"
      }
    },
    "missing_evidence_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/missingEvidenceSummary"
      }
    },
    "blocker_summary": {
      "$ref": "#/$defs/stringArray"
    },
    "safest_next_preparation_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "candidate_id",
        "reason",
        "admits_execution",
        "admits_publication",
        "requires_future_pr",
        "requires_explicit_approval_before_admission"
      ],
      "properties": {
        "slice_id": {
          "type": "string",
          "const": "candidate_specific_dry_run_planning_v1"
        },
        "candidate_id": {
          "type": "string",
          "const": "release_candidate_package_publish_dry_run_v1"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "admits_execution": {
          "type": "boolean",
          "const": false
        },
        "admits_publication": {
          "type": "boolean",
          "const": false
        },
        "requires_future_pr": {
          "type": "boolean",
          "const": true
        },
        "requires_explicit_approval_before_admission": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "unsafe_claims_detected": {
      "type": "boolean",
      "const": false
    },
    "approval_phrase_required": {
      "type": "string",
      "const": "APPROVE EXECUTION ADMISSION <candidate_id>"
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "evidence_only",
        "not_authoritative"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "o3de_execution_status",
        "editor_runtime_execution_status",
        "asset_processor_execution_status",
        "blender_dcc_execution_status",
        "profiler_benchmark_execution_status",
        "live_screenshot_capture_status",
        "spawn_publish_status",
        "cache_live_db_access_status",
        "production_write_status",
        "engine_write_status"
      ],
      "properties": {
        "o3de_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "editor_runtime_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "asset_processor_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "blender_dcc_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "profiler_benchmark_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "live_screenshot_capture_status": {
          "type": "string",
          "const": "blocked"
        },
        "spawn_publish_status": {
          "type": "string",
          "const": "blocked"
        },
        "cache_live_db_access_status": {
          "type": "string",
          "const": "blocked"
        },
        "production_write_status": {
          "type": "string",
          "const": "blocked"
        },
        "engine_write_status": {
          "type": "string",
          "const": "blocked"
        }
      }
    },
    "safety_notes": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "emptyStringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 0,
      "uniqueItems": true
    },
    "missingEvidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "missing_evidence_count",
        "missing_evidence_item_ids"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "missing_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_evidence_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "candidateRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_type",
        "matrix_status",
        "preflight_contract_status",
        "preflight_proof_package_status",
        "admission_status",
        "preflight_passed",
        "proof_package_status",
        "missing_evidence_count",
        "missing_evidence_item_ids",
        "blocker_reason_codes",
        "required_validator",
        "required_receipt_schema",
        "approval_phrase_required",
        "safest_next_action",
        "can_advance_without_explicit_approval",
        "safety_notes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_type": {
          "type": "string",
          "enum": [
            "evidence_only",
            "no_op_receipt",
            "dry_run",
            "real_execution",
            "publication"
          ]
        },
        "matrix_status": {
          "type": "string",
          "minLength": 1
        },
        "preflight_contract_status": {
          "type": "string",
          "minLength": 1
        },
        "preflight_proof_package_status": {
          "type": "string",
          "minLength": 1
        },
        "admission_status": {
          "type": "string",
          "enum": [
            "unadmitted",
            "admitted_no_op_only",
            "admitted_real_execution",
            "admitted_publication"
          ]
        },
        "preflight_passed": {
          "type": "boolean"
        },
        "proof_package_status": {
          "type": "string",
          "enum": [
            "requirements_only",
            "blocked_missing_evidence",
            "blocked_missing_validator",
            "blocked_missing_receipt_schema",
            "blocked_missing_rollback_plan",
            "blocked_missing_approval",
            "satisfied_no_op_only",
            "satisfied_non_execution_only",
            "superseded",
            "rejected"
          ]
        },
        "missing_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_evidence_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocker_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_validator": {
          "type": "string"
        },
        "required_receipt_schema": {
          "type": "string"
        },
        "approval_phrase_required": {
          "type": "string",
          "pattern": "^APPROVE EXECUTION ADMISSION [A-Za-z0-9_-]+$"
        },
        "safest_next_action": {
          "type": "string",
          "minLength": 1
        },
        "can_advance_without_explicit_approval": {
          "type": "boolean"
        },
        "safety_notes": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "candidate_id": {
                "const": "release_candidate_package_receipt_noop_v1"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_type": {
                "const": "no_op_receipt"
              },
              "admission_status": {
                "const": "admitted_no_op_only"
              },
              "proof_package_status": {
                "enum": [
                  "satisfied_no_op_only",
                  "satisfied_non_execution_only"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate_type": {
                "const": "real_execution"
              }
            }
          },
          "then": {
            "properties": {
              "admission_status": {
                "const": "unadmitted"
              },
              "preflight_passed": {
                "const": false
              },
              "missing_evidence_count": {
                "minimum": 1
              },
              "missing_evidence_item_ids": {
                "minItems": 1
              },
              "blocker_reason_codes": {
                "minItems": 1
              },
              "required_validator": {
                "minLength": 1
              },
              "required_receipt_schema": {
                "minLength": 1
              },
              "can_advance_without_explicit_approval": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate_type": {
                "const": "publication"
              }
            }
          },
          "then": {
            "properties": {
              "admission_status": {
                "const": "unadmitted"
              },
              "preflight_passed": {
                "const": false
              },
              "missing_evidence_count": {
                "minimum": 1
              },
              "missing_evidence_item_ids": {
                "minItems": 1
              },
              "blocker_reason_codes": {
                "minItems": 1
              },
              "required_validator": {
                "minLength": 1
              },
              "required_receipt_schema": {
                "minLength": 1
              },
              "can_advance_without_explicit_approval": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate_type": {
                "const": "dry_run"
              }
            }
          },
          "then": {
            "properties": {
              "admission_status": {
                "const": "unadmitted"
              },
              "preflight_passed": {
                "const": false
              },
              "missing_evidence_count": {
                "minimum": 1
              },
              "missing_evidence_item_ids": {
                "minItems": 1
              },
              "blocker_reason_codes": {
                "minItems": 1
              },
              "required_validator": {
                "minLength": 1
              },
              "can_advance_without_explicit_approval": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
