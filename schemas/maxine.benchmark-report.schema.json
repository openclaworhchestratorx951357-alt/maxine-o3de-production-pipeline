{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine.benchmark-report.schema.json",
  "title": "MAXINE Reconstruction Benchmark Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_id",
    "status",
    "network_calls_performed",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "network_calls_performed": {
      "type": "boolean",
      "const": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "license",
          "artifact_hashes"
        ],
        "additionalProperties": true
      }
    }
  }
}
