{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine.editor-smoke-report.schema.json",
  "title": "MAXINE Editor Python Smoke Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "report_id",
    "generated_at",
    "mode",
    "status",
    "integration_enabled",
    "strict_integration",
    "live_editor_execution",
    "editor_python_bindings_required",
    "editor_python_bindings_available",
    "o3de_engine_root_present",
    "o3de_project_path_present",
    "editor_executable",
    "command_preview",
    "exit_code",
    "stdout_log_ref",
    "stderr_log_ref",
    "editor_log_ref",
    "asset_processor_log_ref",
    "platform",
    "lane",
    "level_strategy",
    "manifest_ref",
    "evidence_bundle_ref",
    "package_ref",
    "prefab_ref",
    "procprefab_ref",
    "source_uuid",
    "source_assets",
    "expected_products",
    "produced_products",
    "pending_assets",
    "missing_products",
    "product_resolver_report_ref",
    "asset_processor_batch_report_ref",
    "entity_expectations",
    "component_expectations",
    "instantiated_entities",
    "missing_components",
    "screenshots",
    "cache_heuristic_used",
    "errors",
    "warnings",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "editor_smoke_fixture_bridge_v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "fixture",
        "local_editor_python",
        "unavailable",
        "invalid"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "stalled",
        "skipped",
        "unavailable"
      ]
    },
    "integration_enabled": {
      "type": "boolean"
    },
    "strict_integration": {
      "type": "boolean"
    },
    "live_editor_execution": {
      "type": "boolean"
    },
    "live_asset_processor_batch_execution": {
      "type": "boolean"
    },
    "live_publication": {
      "type": "boolean"
    },
    "release_packaging": {
      "type": "boolean"
    },
    "production_level_mutation": {
      "type": "boolean"
    },
    "editor_python_bindings_required": {
      "type": "boolean"
    },
    "editor_python_bindings_available": {
      "type": "boolean"
    },
    "o3de_engine_root_present": {
      "type": "boolean"
    },
    "o3de_project_path_present": {
      "type": "boolean"
    },
    "editor_executable": {
      "type": "string"
    },
    "command_preview": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_log_ref": {
      "type": "string"
    },
    "stderr_log_ref": {
      "type": "string"
    },
    "editor_log_ref": {
      "type": "string"
    },
    "asset_processor_log_ref": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": [
        "draft_mesh",
        "release_rigged",
        "external_rig_import"
      ]
    },
    "level_strategy": {
      "type": "string",
      "enum": [
        "fixture",
        "temp_sandbox_level",
        "existing_level_readonly",
        "unavailable"
      ]
    },
    "manifest_ref": {
      "type": "string"
    },
    "evidence_bundle_ref": {
      "type": "string"
    },
    "package_ref": {
      "type": "string"
    },
    "prefab_ref": {
      "type": "string"
    },
    "procprefab_ref": {
      "type": "string"
    },
    "source_uuid": {
      "type": "string"
    },
    "product_resolver_report_ref": {
      "type": "string"
    },
    "asset_processor_batch_report_ref": {
      "type": "string"
    },
    "source_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path"
        ]
      }
    },
    "expected_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "produced_products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "product_type",
          "product_path",
          "platform",
          "status"
        ]
      }
    },
    "pending_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "missing_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entity_expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "component_expectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instantiated_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "missing_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cache_heuristic_used": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "kind"
        ]
      }
    }
  }
}
