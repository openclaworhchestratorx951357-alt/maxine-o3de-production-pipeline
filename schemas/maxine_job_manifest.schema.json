{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_job_manifest.schema.json",
  "title": "MAXINE Job Manifest",
  "description": "Manifest-first contract for M.A.X.I.N.E. O3DE production pipeline jobs. Manifest v1 is forward-compatible and allows legacy fields.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "job",
    "identity",
    "inputs",
    "qc",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "job_id",
        "lane",
        "status"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "type": "string",
          "enum": [
            "draft_mesh",
            "text_mesh",
            "photo_rig_prep",
            "text_full_rig",
            "external_rig_import",
            "release_character"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "cancelled",
            "pass",
            "warn",
            "fail",
            "pending_manual",
            "running",
            "queued"
          ]
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "ci",
            "unknown"
          ]
        },
        "created_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_utc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "package_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "draft",
            "npc",
            "hero",
            "test",
            "unknown"
          ]
        },
        "package_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "character_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "character_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_tag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputs": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "generation": {
      "type": "object",
      "additionalProperties": true
    },
    "dcc_conform": {
      "type": "object",
      "additionalProperties": true
    },
    "o3de": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_products": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "products": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "type": "string",
          "enum": [
            "not_run",
            "pass",
            "warn",
            "fail"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "runtime_validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "spawned": {
          "type": "boolean"
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "manifest_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdout_log": {
          "type": [
            "string",
            "null"
          ]
        },
        "stderr_log": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "pipeline_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "undo": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "retention_class": {
          "type": "string",
          "enum": [
            "draft-7d",
            "release-365d",
            "manual",
            "unknown"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "manual_review": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_state": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      }
    }
  }
}
