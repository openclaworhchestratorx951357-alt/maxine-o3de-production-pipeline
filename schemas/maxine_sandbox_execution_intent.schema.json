{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_sandbox_execution_intent.schema.json",
  "title": "MAXINE Sandbox Execution Intent",
  "description": "Planning-only execution intent artifact. This does not authorize implementation or execute writes.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "intent_id",
    "final_preflight_report_id",
    "sandbox_write_plan_id",
    "sandbox_id",
    "intent_status",
    "intent_scope",
    "intent_recorded_by",
    "intent_recorded_at_utc",
    "notes",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "final_preflight_report_id": {
      "type": "string",
      "minLength": 1
    },
    "sandbox_write_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "sandbox_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_status": {
      "type": "string",
      "enum": [
        "intent_recorded",
        "intent_blocked",
        "intent_hold"
      ]
    },
    "intent_scope": {
      "type": "string",
      "minLength": 1
    },
    "intent_recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "intent_recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "array"
    },
    "safety": {
      "type": "object",
      "required": [
        "execution_intent_only",
        "implementation_available",
        "sandbox_write_allowed",
        "rollback_execution_allowed",
        "authoritative_write_allowed",
        "production_paths_allowed",
        "product_resolution_allowed",
        "asset_id_claims_allowed"
      ],
      "properties": {
        "execution_intent_only": {
          "const": true
        },
        "implementation_available": {
          "const": false
        },
        "sandbox_write_allowed": {
          "const": false
        },
        "rollback_execution_allowed": {
          "const": false
        },
        "authoritative_write_allowed": {
          "const": false
        },
        "production_paths_allowed": {
          "const": false
        },
        "product_resolution_allowed": {
          "const": false
        },
        "asset_id_claims_allowed": {
          "const": false
        }
      }
    }
  }
}
