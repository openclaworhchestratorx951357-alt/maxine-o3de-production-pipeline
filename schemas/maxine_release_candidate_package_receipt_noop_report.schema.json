{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_release_candidate_package_receipt_noop_report.schema.json",
  "title": "MAXINE Release Candidate Package Receipt No-Op Report v1",
  "description": "Admitted no-op receipt report for release_candidate_package_receipt_noop_v1. This contract records bounded receipt generation only and does not admit external execution or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "status",
    "receipt_id",
    "candidate_id",
    "admission_decision_ref",
    "approval_phrase",
    "approval_status",
    "operator_approval_required",
    "operator_approval_present",
    "started_at",
    "finished_at",
    "input_refs",
    "output_refs",
    "evidence_hashes",
    "command_invoked",
    "command_mode",
    "external_execution_performed",
    "publication_performed",
    "o3de_execution_status",
    "editor_execution_status",
    "runtime_execution_status",
    "asset_processor_execution_status",
    "blender_dcc_execution_status",
    "cache_live_db_access_status",
    "spawn_publish_status",
    "production_write_status",
    "source_uuid_claim_status",
    "asset_id_claim_status",
    "product_id_claim_status",
    "result",
    "findings",
    "post_validation",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "RELEASE_CANDIDATE_PACKAGE_RECEIPT_NOOP_v1_REPORT"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "const": "release_candidate_package_receipt_noop_v1"
    },
    "admission_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "approval_phrase": {
      "type": "string",
      "const": "APPROVE EXECUTION ADMISSION release_candidate_package_receipt_noop_v1"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "missing"
      ]
    },
    "operator_approval_required": {
      "type": "boolean",
      "const": true
    },
    "operator_approval_present": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha256"
      ],
      "properties": {
        "input_sha256": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "command_invoked": {
      "type": "string",
      "minLength": 1
    },
    "command_mode": {
      "type": "string",
      "const": "noop"
    },
    "external_execution_performed": {
      "type": "boolean",
      "const": false
    },
    "publication_performed": {
      "type": "boolean",
      "const": false
    },
    "o3de_execution_status": {
      "type": "string",
      "const": "blocked"
    },
    "editor_execution_status": {
      "type": "string",
      "const": "blocked"
    },
    "runtime_execution_status": {
      "type": "string",
      "const": "blocked"
    },
    "asset_processor_execution_status": {
      "type": "string",
      "const": "blocked"
    },
    "blender_dcc_execution_status": {
      "type": "string",
      "const": "blocked"
    },
    "cache_live_db_access_status": {
      "type": "string",
      "const": "blocked"
    },
    "spawn_publish_status": {
      "type": "string",
      "const": "blocked"
    },
    "production_write_status": {
      "type": "string",
      "const": "blocked"
    },
    "source_uuid_claim_status": {
      "type": "string",
      "const": "not_authoritative"
    },
    "asset_id_claim_status": {
      "type": "string",
      "const": "not_authoritative"
    },
    "product_id_claim_status": {
      "type": "string",
      "const": "not_authoritative"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "severity",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "post_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safety_verifier_required",
        "proof_flow_required",
        "working_tree_clean_required"
      ],
      "properties": {
        "safety_verifier_required": {
          "type": "boolean",
          "const": true
        },
        "proof_flow_required": {
          "type": "boolean",
          "const": true
        },
        "working_tree_clean_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "const": "qc.gates[]"
        },
        "future_target_path": {
          "type": "string",
          "const": "qc.checks[]"
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "const": "release_candidate_package_receipt_noop_v1"
            },
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "warn",
                "fail"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
