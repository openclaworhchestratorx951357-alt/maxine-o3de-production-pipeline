{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_manual_hero_review_report.schema.json",
  "title": "MAXINE Manual Hero Review Report",
  "description": "Evidence-only manual hero review gate report contract with controlled-real evidence references for release-lane readiness.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_type",
    "job_id",
    "package_id",
    "lane",
    "status",
    "candidate_id",
    "review_id",
    "review_profile_id",
    "review_profile_version",
    "review_tier",
    "evidence_class",
    "reviewer_identity_status",
    "reviewer_name_or_handle",
    "review_timestamp",
    "reviewed_evidence_refs",
    "required_evidence_present_status",
    "visual_quality_status",
    "material_quality_status",
    "skeleton_quality_status",
    "animation_quality_status",
    "scale_orientation_status",
    "package_readiness_status",
    "waiver_status",
    "waiver_reasons",
    "reviewer_findings",
    "decision",
    "release_recommendation",
    "claim_status",
    "safety",
    "source",
    "findings",
    "manifest_attachment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_type": {
      "type": "string",
      "const": "MANUAL_HERO_REVIEW_v1_REPORT"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/checkStatus"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "review_profile_id": {
      "type": "string",
      "const": "MANUAL_HERO_REVIEW_v1"
    },
    "review_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "review_tier": {
      "type": "string",
      "enum": [
        "hero",
        "npc",
        "prop"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "fixture",
        "imported",
        "controlled_real",
        "manual"
      ]
    },
    "reviewer_identity_status": {
      "type": "string",
      "enum": [
        "fixture_reviewer",
        "assigned_reviewer",
        "approved_reviewer"
      ]
    },
    "reviewer_name_or_handle": {
      "type": "string",
      "minLength": 1
    },
    "review_timestamp": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence_present_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "visual_quality_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "material_quality_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "skeleton_quality_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "animation_quality_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "scale_orientation_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "package_readiness_status": {
      "$ref": "#/$defs/checkStatus"
    },
    "waiver_status": {
      "type": "string",
      "enum": [
        "none",
        "waived"
      ]
    },
    "waiver_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decision": {
      "$ref": "#/$defs/checkStatus"
    },
    "release_recommendation": {
      "type": "string",
      "enum": [
        "approve_for_release_candidate",
        "approve_with_warnings",
        "reject",
        "pending_manual_review"
      ]
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "evidence_only",
        "not_authoritative"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "execution_status",
        "o3de_execution_status",
        "editor_execution_status",
        "runtime_execution_status",
        "dcc_execution_status",
        "asset_processor_execution_status",
        "production_write_status"
      ],
      "properties": {
        "execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "o3de_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "editor_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "runtime_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "dcc_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "asset_processor_execution_status": {
          "type": "string",
          "const": "blocked"
        },
        "production_write_status": {
          "type": "string",
          "const": "blocked"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_path",
        "source_kind"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "manifest_attachment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "target_path",
        "future_target_path",
        "qc_check"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "future_target_path": {
          "type": "string",
          "minLength": 1
        },
        "qc_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "check_id",
            "result",
            "severity",
            "details"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "const": "manual_hero_review_v1"
            },
            "result": {
              "$ref": "#/$defs/checkStatus"
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "manual_review"
              ]
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  },
  "$defs": {
    "checkStatus": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "pending_manual"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "severity",
        "status",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "manual_review"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
