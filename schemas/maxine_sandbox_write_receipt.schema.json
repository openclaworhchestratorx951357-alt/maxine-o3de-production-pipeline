{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_sandbox_write_receipt.schema.json",
  "title": "Maxine Sandbox Write Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "receipt_id",
    "command_name",
    "input_plan_path",
    "sandbox_root",
    "target_path",
    "write_attempted",
    "write_succeeded",
    "mutation_scope",
    "blocked_reason",
    "status",
    "rollback_status",
    "files_written",
    "sha256_before",
    "sha256_after",
    "rollback_receipt_hint",
    "receipt_path",
    "receipt_index_path",
    "timestamp_utc"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "command_name": {
      "type": "string",
      "const": "Invoke-MaxineSandboxResolverWrite.ps1"
    },
    "input_plan_path": {
      "type": "string"
    },
    "sandbox_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "write_attempted": {
      "type": "boolean"
    },
    "write_succeeded": {
      "type": "boolean"
    },
    "mutation_scope": {
      "type": "string",
      "const": "sandbox_only"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "written",
        "rolled_back",
        "blocked",
        "failed"
      ]
    },
    "rollback_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "rolled_back",
        "rollback_failed"
      ]
    },
    "files_written": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sha256_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_receipt_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "receipt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "receipt_index_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "minLength": 1
    }
  }
}
