{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxine.local/schemas/maxine_release_candidate_publication_dry_run_operator_approval_packet_completeness.schema.json",
  "title": "MAXINE Release Candidate Publication Dry-Run Operator Approval Packet Completeness Review v1",
  "description": "Static completeness review for release_candidate_package_publish_dry_run_v1. Structural completeness is not approval readiness, approval, admission, execution, receipt issuance, publication, or production readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "review_id",
    "review_version",
    "candidate_id",
    "candidate_type",
    "completeness_review_status",
    "admission_status",
    "packet_structurally_complete",
    "packet_internally_consistent",
    "packet_complete_for_future_review_template",
    "approval_request_ready",
    "operator_approval_granted",
    "approval_phrase_present",
    "dry_run_admitted",
    "receipt_issued",
    "publication_admitted",
    "real_execution_admitted",
    "production_ready_claimed",
    "generated_from_static_artifacts_only",
    "source_artifacts",
    "source_artifact_validation_status",
    "completeness_checks",
    "consistency_checks",
    "required_packet_sections_status",
    "required_cross_references_status",
    "required_validation_commands_status",
    "required_forbidden_surface_status",
    "required_operator_decision_fields_status",
    "required_rollback_cleanup_status",
    "unresolved_approval_blockers",
    "unresolved_execution_blockers",
    "unresolved_publication_blockers",
    "unresolved_receipt_blockers",
    "unsafe_claims_detected",
    "approval_phrase_required",
    "approval_decision_reference",
    "safest_next_action",
    "safety_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_type": {
      "type": "string",
      "const": "RELEASE_CANDIDATE_PUBLICATION_DRY_RUN_OPERATOR_APPROVAL_PACKET_COMPLETENESS_v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "review_version": {
      "type": "string",
      "const": "v1"
    },
    "candidate_id": {
      "type": "string",
      "const": "release_candidate_package_publish_dry_run_v1"
    },
    "candidate_type": {
      "type": "string",
      "const": "dry_run"
    },
    "completeness_review_status": {
      "type": "string",
      "enum": [
        "static_completeness_valid_blocked",
        "static_completeness_invalid",
        "blocked_missing_source_artifact",
        "blocked_inconsistent_source_artifacts",
        "superseded"
      ]
    },
    "admission_status": {
      "type": "string",
      "const": "unadmitted"
    },
    "packet_structurally_complete": {
      "type": "boolean",
      "const": true
    },
    "packet_internally_consistent": {
      "type": "boolean",
      "const": true
    },
    "packet_complete_for_future_review_template": {
      "type": "boolean",
      "const": true
    },
    "approval_request_ready": {
      "type": "boolean",
      "const": false
    },
    "operator_approval_granted": {
      "type": "boolean",
      "const": false
    },
    "approval_phrase_present": {
      "type": "boolean",
      "const": false
    },
    "dry_run_admitted": {
      "type": "boolean",
      "const": false
    },
    "receipt_issued": {
      "type": "boolean",
      "const": false
    },
    "publication_admitted": {
      "type": "boolean",
      "const": false
    },
    "real_execution_admitted": {
      "type": "boolean",
      "const": false
    },
    "production_ready_claimed": {
      "type": "boolean",
      "const": false
    },
    "generated_from_static_artifacts_only": {
      "type": "boolean",
      "const": true
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_ref",
        "preflight_contracts_ref",
        "preflight_proof_packages_ref",
        "readiness_rollup_ref",
        "dry_run_plan_ref",
        "dry_run_receipt_contract_ref",
        "blocked_unissued_receipt_ref",
        "admission_blocker_checklist_ref",
        "operator_approval_packet_ref",
        "production_readiness_report_ref",
        "noop_receipt_status_ref"
      ],
      "properties": {
        "candidate_matrix_ref": { "type": "string", "minLength": 1 },
        "preflight_contracts_ref": { "type": "string", "minLength": 1 },
        "preflight_proof_packages_ref": { "type": "string", "minLength": 1 },
        "readiness_rollup_ref": { "type": "string", "minLength": 1 },
        "dry_run_plan_ref": { "type": "string", "minLength": 1 },
        "dry_run_receipt_contract_ref": { "type": "string", "minLength": 1 },
        "blocked_unissued_receipt_ref": { "type": "string", "minLength": 1 },
        "admission_blocker_checklist_ref": { "type": "string", "minLength": 1 },
        "operator_approval_packet_ref": { "type": "string", "minLength": 1 },
        "production_readiness_report_ref": { "type": "string", "minLength": 1 },
        "noop_receipt_status_ref": { "type": "string", "minLength": 1 }
      }
    },
    "source_artifact_validation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_matrix_status",
        "preflight_contracts_status",
        "preflight_proof_packages_status",
        "readiness_rollup_status",
        "dry_run_plan_status",
        "dry_run_receipt_contract_status",
        "blocked_unissued_receipt_status",
        "admission_blocker_checklist_status",
        "operator_approval_packet_status",
        "production_readiness_status",
        "noop_receipt_status"
      ],
      "properties": {
        "candidate_matrix_status": { "$ref": "#/$defs/statusValue" },
        "preflight_contracts_status": { "$ref": "#/$defs/statusValue" },
        "preflight_proof_packages_status": { "$ref": "#/$defs/statusValue" },
        "readiness_rollup_status": { "$ref": "#/$defs/statusValue" },
        "dry_run_plan_status": { "$ref": "#/$defs/statusValue" },
        "dry_run_receipt_contract_status": { "$ref": "#/$defs/statusValue" },
        "blocked_unissued_receipt_status": { "$ref": "#/$defs/statusValue" },
        "admission_blocker_checklist_status": { "$ref": "#/$defs/statusValue" },
        "operator_approval_packet_status": { "$ref": "#/$defs/statusValue" },
        "production_readiness_status": { "$ref": "#/$defs/statusValue" },
        "noop_receipt_status": { "$ref": "#/$defs/statusValue" }
      }
    },
    "completeness_checks": { "$ref": "#/$defs/nonEmptyStringArray" },
    "consistency_checks": { "$ref": "#/$defs/nonEmptyStringArray" },
    "required_packet_sections_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_sections_present",
        "missing_sections"
      ],
      "properties": {
        "all_required_sections_present": { "type": "boolean", "const": true },
        "missing_sections": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "required_cross_references_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_cross_references_present",
        "missing_cross_references"
      ],
      "properties": {
        "all_required_cross_references_present": { "type": "boolean", "const": true },
        "missing_cross_references": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "required_validation_commands_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_validation_commands_present",
        "missing_validation_commands",
        "required_validation_commands"
      ],
      "properties": {
        "all_required_validation_commands_present": { "type": "boolean", "const": true },
        "missing_validation_commands": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "required_validation_commands": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "required_forbidden_surface_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbidden_surfaces_represented",
        "blocked_surfaces_confirmed",
        "forbidden_surface_tokens"
      ],
      "properties": {
        "forbidden_surfaces_represented": { "type": "boolean", "const": true },
        "blocked_surfaces_confirmed": { "type": "boolean", "const": true },
        "forbidden_surface_tokens": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "required_operator_decision_fields_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_fields_present",
        "decision_fields_populated",
        "approval_decision_reference_present"
      ],
      "properties": {
        "decision_fields_present": { "type": "boolean", "const": true },
        "decision_fields_populated": { "type": "boolean", "const": false },
        "approval_decision_reference_present": { "type": "boolean", "const": false }
      }
    },
    "required_rollback_cleanup_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_or_cleanup_required",
        "rollback_or_cleanup_evidence_present",
        "rollback_or_cleanup_blocked"
      ],
      "properties": {
        "rollback_or_cleanup_required": { "type": "boolean", "const": true },
        "rollback_or_cleanup_evidence_present": { "type": "boolean", "const": false },
        "rollback_or_cleanup_blocked": { "type": "boolean", "const": true }
      }
    },
    "unresolved_approval_blockers": { "$ref": "#/$defs/nonEmptyStringArray" },
    "unresolved_execution_blockers": { "$ref": "#/$defs/nonEmptyStringArray" },
    "unresolved_publication_blockers": { "$ref": "#/$defs/nonEmptyStringArray" },
    "unresolved_receipt_blockers": { "$ref": "#/$defs/nonEmptyStringArray" },
    "unsafe_claims_detected": {
      "type": "boolean",
      "const": false
    },
    "approval_phrase_required": {
      "type": "string",
      "const": "APPROVE EXECUTION ADMISSION release_candidate_package_publish_dry_run_v1"
    },
    "approval_decision_reference": {
      "type": ["null", "string"]
    },
    "safest_next_action": {
      "type": "string",
      "minLength": 1
    },
    "safety_notes": { "$ref": "#/$defs/nonEmptyStringArray" }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statusValue": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_decision_reference": {
            "type": "string"
          }
        },
        "required": ["approval_decision_reference"]
      },
      "then": {
        "properties": {
          "approval_decision_reference": {
            "maxLength": 0
          }
        }
      }
    },
    {
      "properties": {
        "unresolved_approval_blockers": {
          "contains": { "const": "missing_approval_decision" }
        }
      }
    },
    {
      "properties": {
        "unresolved_approval_blockers": {
          "contains": { "const": "approval_request_not_ready" }
        }
      }
    },
    {
      "properties": {
        "unresolved_approval_blockers": {
          "contains": { "const": "operator_approval_not_granted" }
        }
      }
    },
    {
      "properties": {
        "unresolved_approval_blockers": {
          "contains": { "const": "approval_phrase_not_present" }
        }
      }
    },
    {
      "properties": {
        "unresolved_execution_blockers": {
          "contains": { "const": "dry_run_not_admitted" }
        }
      }
    },
    {
      "properties": {
        "unresolved_execution_blockers": {
          "contains": { "const": "dry_run_not_executed" }
        }
      }
    },
    {
      "properties": {
        "unresolved_receipt_blockers": {
          "contains": { "const": "receipt_not_issued" }
        }
      }
    },
    {
      "properties": {
        "unresolved_receipt_blockers": {
          "contains": { "const": "rollback_cleanup_evidence_missing" }
        }
      }
    },
    {
      "properties": {
        "unresolved_publication_blockers": {
          "contains": { "const": "publication_surfaces_blocked_by_policy" }
        }
      }
    },
    {
      "properties": {
        "unresolved_publication_blockers": {
          "contains": { "const": "publication_not_admitted" }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_execution_admission_candidate_matrix.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_execution_admission_preflight_contracts.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_execution_admission_preflight_proof_packages.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_execution_admission_readiness_rollup.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_release_candidate_publication_dry_run_plan.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_release_candidate_publication_dry_run_receipt.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_release_candidate_publication_dry_run_admission_blockers.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/execution-admission/validate_release_candidate_publication_dry_run_operator_approval_packet.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/audit/verify_sandbox_writer_safety.py"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "required_validation_commands_status": {
          "properties": {
            "required_validation_commands": {
              "contains": {
                "const": "tools/release-lane/prove_pilot_release_chain.py"
              }
            }
          }
        }
      }
    }
  ]
}
