# MAXINE private Windows O3DE runner environment template.
# This file is a documentation template only. Do not commit machine-specific copies.
#
# Do not paste runner registration tokens here.
# Do not store credentials here.
# Do not point O3DE_PROJECT_PATH at a production project until dry-run readiness passes.
# Keep Editor smoke disabled for the APB-only first live run.
# Live APB requires manual workflow confirmation and explicit gates.

O3DE_ENGINE_ROOT=
O3DE_PROJECT_PATH=
O3DE_EDITOR_EXECUTABLE=
ASSET_PROCESSOR_BATCH_EXECUTABLE=

MAXINE_ENABLE_O3DE_INTEGRATION=1
MAXINE_ENABLE_ASSET_PROCESSOR_BATCH=1
MAXINE_ENABLE_O3DE_EDITOR_SMOKE=0
MAXINE_ALLOW_LIVE_O3DE_COMMANDS=0

MAXINE_GOLDEN_PROJECT_FIXTURE=examples/o3de-golden-project/maxine-golden-project.fixture.json
MAXINE_GOLDEN_CORPUS=examples/golden-corpus
MAXINE_ARTIFACT_ROOT=artifacts/o3de-integration
MAXINE_RUN_MODE=readiness
